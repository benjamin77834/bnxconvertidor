out::join(in0,in1)=
begin
out.sourcesystemidentifier              ::if(!is_null(in0.sourcesystemidentifier)) if (in0.sourcesystemidentifier == 54) in0.sourcesystemidentifier else 200 else 200;
out.accountnumber                       ::if(!is_null(in0.accountnumber)) in0.accountnumber else "0";
out.transactionamount                   ::if(!is_null(in0.transactionamount)) in0.transactionamount else 0;
out.currencycode                        ::if(!is_null(in0.currencycode)) in0.currencycode else 0;
out.accountbranchnumber                 ::if(!is_null(in0.accountbranchnumber)) in0.accountbranchnumber else 0;
out.num_prefijocuenta                   ::if(!is_null(in0.accountbranchnumber)) in0.accountbranchnumber else 0;
out.num_cuenta                          ::if(!is_null(in0.accountnumber) and is_valid((decimal(20))in0.accountnumber)) (decimal(20))decimal_strip(in0.accountnumber) else 0;
out.transactiontypecodecpt              ::if(!is_null(in0.transactiontypecode)) in0.transactiontypecode else 0;
out.transactionidentification           ::if(!is_null(in0.transactionidentification)) in0.transactionidentification else 0;
out.num_producto                        ::if(!is_null(in0.producttypecode)) in0.producttypecode else 0;
out.num_instrumento                     ::if(!is_null(in0.contractinstrumenttype)) in0.contractinstrumenttype else 0;
out.* :: in1.*;
end;|3|1|l|@{0|}}
