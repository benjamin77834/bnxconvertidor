EXCHANGERATE, 
TRANSACTIONSTATUS, 
OUTPUTTRANSACTIONSTATUS, 
ACCOUNTBRANCHNUMBER, 
ACCOUNTAGENTIDENTIFIER, 
SEQUENCENUMBER, 
EXCHANGERATETOCONVERTEDCURRENCY, 
TRANSFERREFERENCENUMBER, 
SYSTEMCOVERAGETYPE, 
CAST( REQUESTEDMOVEMENTTRANSACTIONTIME AS TIME FORMAT 'HH:MI:SS') AS LOCALTRANSACTIONTIME,
PRODUCTTYPECODE,
CONTRACTINSTRUMENTTYPE
FROM FZ1DBCRTTRANSACSUC 
WHERE 
BRANCHNUMBER IN (SELECT SUCDEPTO FROM EE1D01ESTRUC80 WHERE OFICINA = 24) AND 
OUTPUTTRANSACTIONSTATUS = 0 AND 
CURRENCYCODE = 5 AND 
TRANSACTIONSTATUS IN (0, 300) AND 
ACCOUNTTRANSACTIONTYPECODE IN (100, 200) AND 
TRANSACTIONTYPECODE IN (SELECT DISTINCT TRANSACTIONTYPECODEGOING FROM D_MX_RRMI_T1.IP1C01_RDI_RULLE WHERE TRANSACTIONTYPECODEEXCLUTORY = '0' AND CONFIGURATIONSTATUS = '2') AND 
REQUESTEDMOVEMENTTRANSACTIONTIME > CAST((CONCAT('2022-05-06',' 17:00:00')) AS TIMESTAMP(6) FORMAT 'YYYY-MM-DDBHH:MI:SS') AND 
REQUESTEDMOVEMENTTRANSACTIONTIME <= CAST((CONCAT('2022-05-06',' 23:59:59')) AS TIMESTAMP(6) FORMAT 'YYYY-MM-DDBHH:MI:SS') 
ORDER BY TRANSACTIONBOOKDATE, EMPLOYEENUMBER, INSTRUCTIONIDENTIFICATION, TRANSACTIONIDENTIFICATION;
 * On: Sun May  8 12:53:12 2022
 */
record
  decimal("\\x01",0) employeenumber = NULL("") /*INTEGER*/;
  decimal("\\x01",0) instructionidentification = NULL("") /*INTEGER*/;
  decimal("\\x01",0) branchnumber = NULL("") /*INTEGER*/;
  decimal("\\x01",0) transactionidentification = NULL("") /*INTEGER*/;
  date("YYYY-MM-DD")("\\x01") transactionbookdate = NULL("") /*DATE*/;
  utf8 string("\\x01", maximum_length=24) amcinstructionidentifier = NULL("") /*VARCHAR(12) CHARACTER SET LATIN*/;
  decimal("\\x01",0) sourcesystemidentifier = NULL("") /*SMALLINT*/;
  decimal("\\x01",0) transactiontypecode = NULL("") /*INTEGER*/;
  decimal("\\x01",0) accounttransactiontypecode = NULL("") /*SMALLINT*/;
  decimal("\\x01",0) customerbranchnumber = NULL("") /*INTEGER*/;
  utf8 string("\\x01", maximum_length=40) contractnumber = NULL("") /*VARCHAR(20) CHARACTER SET LATIN*/;
  utf8 string("\\x01", maximum_length=40) accountnumber = NULL("") /*VARCHAR(20) CHARACTER SET LATIN*/;
  decimal("\\x01".2, maximum_length=20, sign_reserved) transactionamount = NULL("") /*DECIMAL(18,2)*/;
  decimal("\\x01",0) currencycode = NULL("") /*SMALLINT*/;
  decimal("\\x01".12, maximum_length=28, sign_reserved) exchangerate = NULL("") /*DECIMAL(26,12)*/;
  decimal("\\x01",0) transactionstatus = NULL("") /*SMALLINT*/;
  decimal("\\x01",0) outputtransactionstatus = NULL("") /*SMALLINT*/;
  decimal("\\x01",0) accountbranchnumber = NULL("") /*INTEGER*/;
  decimal("\\x01",0) accountagentidentifier = NULL("") /*SMALLINT*/;
  decimal("\\x01",0) sequencenumber = NULL("") /*INTEGER*/;
  decimal("\\x01".12, maximum_length=28, sign_reserved) exchangeratetoconvertedcurrency = NULL("") /*DECIMAL(26,12)*/;
  utf8 string("\\x01", maximum_length=46) transferreferencenumber = NULL("") /*VARCHAR(23) CHARACTER SET LATIN*/;
  decimal("\\x01",0) systemcoveragetype = NULL("") /*SMALLINT*/;
  datetime("HH24:MI:SS.NNNNNN")("\\x01") localtransactiontime = NULL("") /*TIME(6)*/;
  decimal("\\x01",0) producttypecode = NULL("") /*SMALLINT*/;
  decimal("\\x01",0) contractinstrumenttype = NULL("") /*SMALLINT*/;
  decimal("\\x01",0) num_autransaccion /*INTEGER NOT NULL*/;
  decimal("\\x01",0) num_caja /*SMALLINT NOT NULL*/;
  utf8 string("\\x01", maximum_length=3) configurationstatus /*VARCHAR(1) CHARACTER SET UNICODE NOT NULL*/;
  string(1) newline = "\\n";
end|3|2|$|@{0|}}
