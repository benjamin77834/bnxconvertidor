{2010501005|XXGpvertex|109|0|260|0|{|{30100001|XXparameter_set|@@@@{{30001002|XXparameter|!prototype_path|$AB_COMPONENTS/Transform/Join.mpc|3|2|Pf$|@{0|}}
{30001002|XXparameter|in1_metadata||3|8|s=|@{0|}}
{30001002|XXparameter|reject1_metadata||3|8|s=|@{0|}}
{30001002|XXparameter|unused1_metadata||3|8|s=|@{0|}}
{30001002|XXparameter|in0_metadata|$AI_DML/unloader/EIRR_DDOLI010_TRSDOL_05.DTTK_UNLOADER.dml|3|2|f$|@{0|}}
{30001002|XXparameter|reject0_metadata||3|8|s=|@{0|}}
{30001002|XXparameter|unused0_metadata||3|8|s=|@{0|}}
{30001002|XXparameter|key|\{transactionbookdate; employeenumber; instructionidentification; branchnumber\}|3|2|$|@{0|}}
{30001002|XXparameter|transform|/*Join transform*/
let string(50) key = " ";
let decimal(18,2) importepartida = 0;
let decimal(18,2) importecontrapartida = 0;
let decimal(18,2) importecompuestocpt = 0;
let decimal(18,2) importereportado = 0;
let decimal(1)    contrapartidanoaplica = 0;
out::join(in0,in1)=
begin
contrapartidanoaplica = 0;
if(string_lrtrim(key) == string_concat(in1.transactionbookdate,in1.employeenumber,in1.instructionidentification,in1.branchnumber))
begin
//Es decir, es la segunda contrapartida de la partida.

        importecontrapartida = in0.transactionamount;
        importecompuestocpt = importecompuestocpt+importecontrapartida;
        if(importepartida>=importecompuestocpt)
        
        begin
        //En caso de que se pueda agregar el importe entero se agrega y se reporta
                importereportado = in0.transactionamount;
                
        end
        
        //(importecompuestocpt-importecontrapartida) esto es igual al valor anterior compuesto
        else if (importepartida>(importecompuestocpt-importecontrapartida))
        
        begin
        //En caso de que no quede suficiente importe se reporta solo el restante.        
                importereportado = importepartida-(importecompuestocpt-importecontrapartida);
        end
        
        else 
        
        begin
        // En caso de que ya no tengamos espacio de importe prendemos la bandera para filtrar el registro en el siguiente paso
                importereportado = in0.transactionamount;
                contrapartidanoaplica = 1;
        end

end

else 

begin
//Es decir, es la primera partida de la contrapartida
        key = string_concat(in1.transactionbookdate,in1.employeenumber,in1.instructionidentification,in1.branchnumber);
        importepartida = in1.transactionamount;
        importecontrapartida = in0.transactionamount;
        importecompuestocpt = importecontrapartida;
        if(importepartida>=importecompuestocpt )
        
        begin
        //En caso de que se pueda agregar el importe entero se agrega y se reporta
                importereportado = in0.transactionamount;
                
        end
        
        //(importecompuestocpt-importecontrapartida) esto es igual al valor anterior compuesto
        else if (importepartida>(importecompuestocpt-importecontrapartida) )
        
        begin
        //En caso de que no quede suficiente importe se reporta solo el restante.        
                importereportado = importepartida-(importecompuestocpt-importecontrapartida);
        end
        
        else 
        
        begin
        // En caso de que ya no tengamos espacio de importe prendemos la bandera para filtrar el registro en el siguiente paso
                importereportado = in0.transactionamount;
                contrapartidanoaplica = 1;
        end
end


out.* :: in0.*;
out.transactionamount :: importereportado;
out.contrapartidanoaplica :: contrapartidanoaplica;

end;|3|1|l|@{0|}}
