out::join(in0,in1)=
begin
 // let in1.=lookup('Tfm ALS ACCT MAST lkp', in.MIS_DT, in.ACCT_CCY_CDE, in.ACCT_NBR);
  out.N_RT_TOT_COFF_AMT :: in1.N_RT_TOT_COFF_AMT;
