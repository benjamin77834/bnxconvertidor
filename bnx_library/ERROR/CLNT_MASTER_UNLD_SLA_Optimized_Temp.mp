{2010501005|XXGpvertex|173|0|382|0|{|{30100001|XXparameter_set|@@@@{{30001002|XXparameter|transform0|include "~$AI_XFR/transform_function_library.xfr";
// banamex/sr610891/111618/table_adaptor.xfr
out :: reformat(in) =
begin

  out.CCY_CDE :: in.ccy_cde;
  out.MID_RTE :: in.mid_rte;
  out.BUY_RTE :: in.buy_rte;
  out.SELL_RTE :: in.sell_rte;
  out.SPREAD :: in.spread;
  out.FACTOR :: in.factor;
  out.OVERRIDE_VARIENCE :: in.override_varience;
  out.MAINTAINED_VARIENCE :: in.maintained_varience;
  out.DECIMAL_CDE :: in.decimal_cde;
  out.FMS_NBR :: in.fms_nbr;
  out.QUALIFIER :: in.qualifier;
  out.EFF_DT :: in.eff_dt;
  out.BIZ_ORG_CDE :: in.biz_org_cde;
  out.CNTRY_CDE :: in.cntry_cde;
  out.SRC_SYS_ID :: in.cntry_cde;
  out.MIS_DT :: in.mis_dt;
  out.MULTIPLE_OR_DIVIDE_IND :: in.multiple_or_divide_ind;
end|3|1|l|@{0|}}
