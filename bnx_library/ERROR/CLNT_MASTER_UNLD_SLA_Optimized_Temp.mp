out :: reformat(in) =
begin

 
 
 
 
 
  
  
  out.PRD_KEY :: in.prd_key;
  out.CCY_CDE :: in.ccy_cde;
  out.AO_CDE :: in.ao_cde;
  out.ACCT_DOM_RC_CDE :: in.acct_dom_rc_cde;
  out.ACCT_DOM_BR_CDE :: in.acct_dom_br_cde;
  out.DEPT_CDE :: in.dept_cde;
  out.RELN_PRCNG_GRP_CDE :: in.reln_prcng_grp_cde;
  out.GVRNG_STATE_CDE :: in.gvrng_state_cde;
  out.ACCT_NBR :: in.acct_nbr;
  
  
  
  
  out.PRD_CDE :: in.prd_cde;
