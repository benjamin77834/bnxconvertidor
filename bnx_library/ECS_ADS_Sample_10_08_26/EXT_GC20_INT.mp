{30001002|XXparameter|read_metadata|/* DML Generated for SQL: select MIS_DT,ID_NEGOCIACION,NUM_CUENTA, ROLL_DIG,FECHA_NEGOCIACION,FECHA_BOOKEO,FECHA_ESTATUS,ESTATUS_NEGOCIACION_ID_ESTATUS,PLAZO_NEGOCIADO,SALDO_NEGOCIADO,CAMPANIA_ID_CAMPANIA from Q_BANAMEX_V_C.TR2_RMT_NEGOTIATION WHERE MIS_DT =CAST('20211103' AS DATE FORMAT 'YYYYMMDD');;

 * On: Tue Dec 14 19:02:01 2021
 */
record
  date("YYYY-MM-DD")("\\x01") mis_dt = NULL("") /*DATE*/;
  decimal("\\x01",0, maximum_length=11, sign_reserved) id_negociacion /*DECIMAL(10) NOT NULL*/;
  utf8 string("\\x01", maximum_length=28) num_cuenta = NULL("") /*VARCHAR(14) CHARACTER SET LATIN*/;
  utf8 string("\\x01", maximum_length=4) roll_dig = NULL("") /*VARCHAR(2) CHARACTER SET LATIN*/;
  date("YYYY-MM-DD")("\\x01") fecha_negociacion = NULL("") /*DATE*/;
  date("YYYY-MM-DD")("\\x01") fecha_bookeo = NULL("") /*DATE*/;
  date("YYYY-MM-DD")("\\x01") fecha_estatus = NULL("") /*DATE*/;
  decimal("\\x01",0, maximum_length=11, sign_reserved) estatus_negociacion_id_estatus = NULL("") /*DECIMAL(10)*/;
  decimal("\\x01",0, maximum_length=11, sign_reserved) plazo_negociado = NULL("") /*DECIMAL(10)*/;
  decimal("\\x01".14, maximum_length=40, sign_reserved) saldo_negociado = NULL("") /*DECIMAL(38,14)*/;
  decimal("\\x01",0, maximum_length=11, sign_reserved) campania_id_campania = NULL("") /*DECIMAL(10)*/;
  string(1) newline = "\\n";
end|3|1|l|@{0|}}
