{30001002|XXparameter|transform|out::join(in0,in1)=
begin
out.DELINQUENCY_BUCKET :: if(in1.cyc_due <2) 0 else (in1.cyc_due -1);
out.CURRENT_BALANCE :: in1.enr_lcyamt;
out.APR :: in0.APR;
