string(3) APR_STATUS =NULL("");
end|3|1|l|@{0|}}
{30001002|XXparameter|transform|/*Join transform*/
out::join(in0,in1,in2,in3,in4)=
begin

let decimal("") deliquency_bucket = if(!is_null(in2.bill_pymt_freq_cde) and string_lrtrim(in2.bill_pymt_freq_cde) == "S") decimal_round(in3.tot_pymts_due_cnt/2,1) else in3.tot_pymts_due_cnt;

let decimal("") current_balance = if( !is_null(deliquency_bucket) and deliquency_bucket member [vector 0,1,2,3]) (in1.tot_prin_bal_acyamt + in1.loan_add_on_int_acyamt) else in1.tot_prin_bal_acyamt;


out.DELINQUENCY_BUCKET :: deliquency_bucket;
out.CURRENT_BALANCE :: current_balance;
out.APR :: decimal_round(in1.loan_curr_int_rte,2);
out.WRITTE_OFF_DATE :: in4.acct_coff_dt;

out.RW_STATUS :: if (in0.APR_STATUS == 'old' && string_lrtrim(in0.RW_STATUS) == 'CUMPLIDO' &&((!is_null(in4.acct_coff_dt)) \|\| (date_difference_months((date("YYYY-MM-DD"))in0.MIS_DT, (date("YYYY-MM-DD"))in0.TRANSFER_RW_DT) >= first_defined(in0.RMT_TENOR,1234567)) && first_defined(current_balance,0)>250 )) 'ROTO' else if(in0.APR_STATUS == 'new' && (date_difference_months((date("YYYY-MM-DD"))in0.MIS_DT, (date("YYYY-MM-DD"))in0.TRANSFER_RW_DT) <= first_defined(in0.RMT_TENOR,1234567)) && !is_null(current_balance) && current_balance<=250 && current_balance>0) 'CUMPLIDO' else if (in0.APR_STATUS == 'new' && !is_null(current_balance) && current_balance==0) 'CUMPLIDO' else in0.RW_STATUS;

out.* :: in0.*;




end;|3|1|l|@{0|}}
