{2010501005|XXGpvertex|349|0|988|0|{|{30100001|XXparameter_set|@@@@{{30001002|XXparameter|!prototype_path|$AB_COMPONENTS/Transform/Reformat.mpc|3|2|Pf$|@{0|}}
{30001002|XXparameter|out0_metadata|record
string("\|") ID_ACUERDO =NULL("");
string("\\n") Reason =NULL("");
end|3|1|l|@{0|}}
{30001002|XXparameter|transform0|/*Reformat operation*/
out::reformat(in)=
begin
  out.ID_ACUERDO :: in.ID_ACUERDO;
  out.Reason :: if (first_defined(string_lrtrim(in.SYSTEM_ID),"abc") member [vector "297","160","161"]) "id_campaña is member of 297 or 160 or 161"
  else if(is_null(in.CRD_NBR_RW)) "LATEST ACCOUNT NUMBER16 is NULL"
  else if(is_null(in.TRANSFER_RW_DT)) "FEC TRASPASO is NULL" 
  else if(in.TRANSFER_RW_DT<=first_defined(in.RMT_DT_NEG,"1901-01-01")) "FEC TRASPASO is not greater than Negociacion Date" 
  else if(in.MONTHLY_PAYMENT<=0) "Monthly Payment is not greater than 0" 
  else if(in.RW_BAL_BOOK<=0) "SALDO BOOKEADO is not greater than 0"
  else if(is_null(in.FOLIO) and string_lrtrim(in.SYSTEM_RW) == 'S404') "FOLIO is NULL for S404"
  else if(is_null(in.SYSTEM_RW)) "SYSTEM RW is NULL"
  else "";
end;|3|1|l|@{0|}}
