out.RW_STATUS_DT :: if(string_lrtrim(in.RW_STATUS)=='VIGENTE')in.TRANSFER_RW_DT else if(string_lrtrim(in.RW_STATUS)=='ROTO') (date("YYYY-MM-DD"))date_add_months((date("YYYYMMDD"))in.TRANSFER_RW_DT, in.RMT_TENOR) else if(string_lrtrim(in.RW_STATUS)=='CUMPLIDO' && in.APR_STATUS == 'new')$ECS_SC_PRDT else if(string_lrtrim(in.RW_STATUS)=='CUMPLIDO' && in.APR_STATUS == 'old')in.RW_STATUS_DT else in.RW_STATUS_DT;
out.SYSTEM_ID :: string_lrtrim(in.SYSTEM_ID);
out.* :: in.*;

end;|3|1|l|@{0|}}
