{30001002|XXparameter|transform|/*Join transform*/
out::join(in0,in1)=
begin
  out.DELINQUENCY_BUCKET :: first_defined(in1.cnt_menven,0);
  out.CURRENT_BALANCE :: first_defined(in1.sdo_sum,0);
  out.APR :: in0.APR;  
  out.WRITTE_OFF_DATE :: (date("YYYY-MM-DD"))(date("DD/MM/YYYY"))(string(""))string_lrtrim(in1.fecha_wo);
  //out.RW_STATUS :: if ((!is_null(in1.fecha_wo)) \|\| (date_difference_months((date("YYYY-MM-DD"))in0.MIS_DT, (date("YYYY-MM-DD"))in0.TRANSFER_RW_DT) >= first_defined(in0.RMT_TENOR,0)) && first_defined(in1.sdo_sum,0)>250 ) 'ROTO' else if((date_difference_months((date("YYYY-MM-DD"))in0.MIS_DT, (date("YYYY-MM-DD"))in0.TRANSFER_RW_DT) <= first_defined(in0.RMT_TENOR,1234567)) && !is_null(in1.sdo_sum) && in1.sdo_sum<=250 && in1.sdo_sum>0) 'CUMPLIDO' else if(!is_null(in1.sdo_sum) && in1.sdo_sum==0) 'CUMPLIDO' else  'VIGENTE';
  out.RW_STATUS :: if(in0.APR_STATUS == 'old' && string_lrtrim(in0.RW_STATUS) == 'CUMPLIDO' && ((!is_null(in1.fecha_wo)) \|\| (date_difference_months((date("YYYY-MM-DD"))in0.MIS_DT, (date("YYYY-MM-DD"))in0.TRANSFER_RW_DT) >= first_defined(in0.RMT_TENOR,0)) && first_defined(in1.sdo_sum,0)>250 )) 'ROTO' else if(in0.APR_STATUS == 'new' && (date_difference_months((date("YYYY-MM-DD"))in0.MIS_DT, (date("YYYY-MM-DD"))in0.TRANSFER_RW_DT) <= first_defined(in0.RMT_TENOR,1234567)) && first_defined(in1.sdo_sum,0)<=250 && first_defined(in1.sdo_sum,0)>0) 'CUMPLIDO' else if(in0.APR_STATUS == 'new' && first_defined(in1.sdo_sum,123)==0) 'CUMPLIDO' else  in0.RW_STATUS;
  out.* :: in0.*;
end;|3|1|l|@{0|}}
