{30001002|XXparameter|out_metadata|record
date("YYYY-MM-DD") MIS_DT =NULL("");
decimal(16) ID_ACUERDO =NULL("");
string(30) CRD_NBR =NULL("");
date("YYYY-MM-DD") RMT_DT_NEG =NULL("");
date("YYYY-MM-DD") RMT_DT_BOOK =NULL("");
date("YYYY-MM-DD") RMT_DT_CHG_ST =NULL("");
string(30) RMT_STATUS_NEG =NULL("");
decimal(16) RMT_TENOR =NULL("");
decimal(16) RMT_BAL_NEG =NULL("");
string(30) SYSTEM_ID =NULL("");
decimal(16) CUSTOMER_REVENUE =NULL("");
utf8 string("\\x01", maximum_length=60) CRD_NBR_RW =NULL("");
string(30) FOLIO =NULL("");
string(30) SYSTEM_RW =NULL("");
date("YYYY-MM-DD") TRANSFER_RW_DT =NULL("");
decimal(16) MONTHLY_PAYMENT =NULL("");
decimal(16) RW_BAL_BOOK =NULL("");
decimal(16) DELINQUENCY_BUCKET =NULL("");
decimal(16) CURRENT_BALANCE =NULL("");
decimal(16) APR =NULL("");
string(30) RW_STATUS =NULL("");
date("YYYY-MM-DD") RW_STATUS_DT =NULL("");
date("YYYY-MM-DD") WRITTE_OFF_DATE =NULL("");
string(3) APR_STATUS =NULL("");
end|3|1|l|@{0|}}
{30001002|XXparameter|key|\{ID_ACUERDO\}|3|2|$|@{0|}}
{30001002|XXparameter|join_type|Explicit|3|1|l|@{0|}}
{30001002|XXparameter|record_match_required1|False|3|1|l|@{0|}}
{30001002|XXparameter|override_key1|\{id_negociacion\}|3|2|$|@{0|}}
{30001002|XXparameter|transform|/*Join transform*/
out::join(in0,in1)=
begin

  out.MIS_DT :: in0.MIS_DATE;
  out.ID_ACUERDO :: in0.ID_ACUERDO;
  out.CRD_NBR :1: string_concat(string_lrtrim(in1.num_cuenta),in1.roll_dig);
  out.CRD_NBR :2: in0.CRD_NBR;
  out.RMT_DT_NEG :: in1.fecha_negociacion;
  out.RMT_DT_BOOK :: in1.fecha_bookeo;
  out.RMT_DT_CHG_ST :: in1.fecha_estatus;
  out.RMT_STATUS_NEG :: in1.estatus_negociacion_id_estatus;
  out.RMT_TENOR :: in1.plazo_negociado;
  out.RMT_BAL_NEG :: in1.saldo_negociado;
  out.SYSTEM_ID :: in1.campania_id_campania;
  out.CUSTOMER_REVENUE :1: if((in0.CUSTOMER_REVENUE>0) && (first_defined(in1.campania_id_campania,0) not member [vector 297 , 160 , 161]))in0.CUSTOMER_REVENUE else 0;
  out.CUSTOMER_REVENUE :2: in0.CUSTOMER_REVENUE;
  out.CRD_NBR_RW :: in0.CRD_NBR_RW;
  out.FOLIO :: in0.FOLIO;
  out.TRANSFER_RW_DT :: in0.TRANSFER_RW_DT;
  out.SYSTEM_RW :: if (is_null(string_replace(in0.FOLIO," ","")) and string_substring(in0.CRD_NBR_RW,1,6) == '854854') 'ECS' else if (is_null(string_replace(in0.FOLIO," ","")) and string_substring(in0.CRD_NBR_RW,1,6) member [vector '854891','881358']) 'ALS' else if (!is_null(string_replace(in0.FOLIO," ",""))) 'S404' else "";
  out.MONTHLY_PAYMENT :: in0.MONTHLY_PAYMENT;
  out.RW_BAL_BOOK :: in0.RW_BAL_BOOK;
  out.RW_STATUS :: 'VIGENTE';
  out.APR_STATUS :: "new";
end;|3|1|l|@{0|}}
