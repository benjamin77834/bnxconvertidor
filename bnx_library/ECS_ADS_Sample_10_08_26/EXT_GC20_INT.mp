  out.RMT_TENOR :: in.rmt_tenor;
  out.RMT_BAL_NEG :: in.rmt_bal_neg;
  out.SYSTEM_ID :: in.system_id;
  out.CUSTOMER_REVENUE :: in.customer_revenue;
  out.CRD_NBR_RW :: in.crd_nbr_rw;
  out.FOLIO :: in.folio;
  out.SYSTEM_RW :: in.system_rw;
  out.TRANSFER_RW_DT :: in.transfer_rw_dt;
  out.MONTHLY_PAYMENT :: in.monthly_payment;
  out.RW_BAL_BOOK :: in.rw_bal_book;
  out.DELINQUENCY_BUCKET :: in.delinquency_bucket;
  out.CURRENT_BALANCE :: in.current_balance;
  out.APR :: in.apr;
  out.RW_STATUS :: in.rw_status;
  out.RW_STATUS_DT :: in.rw_status_dt;
  out.WRITTE_OFF_DATE :: in.writte_off_date;
  out.APR_STATUS :: "old";
end;|3|1|l|@{0|}}
