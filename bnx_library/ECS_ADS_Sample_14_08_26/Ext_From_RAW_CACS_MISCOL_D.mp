// banamex/sr610891/111618/Ext_From_RAW_CACS_MISCOL_D_V13S0P2.xfr
// Column Import XFR Generated: 2018-12-11 16:12:55 Version: 13269

out::reformat(in)=
begin
  let rec_t _record_=reinterpret_as(rec_t, in._record_);
   $\{_VRULE_V13S0\}
  out.* :2: in.*;
  out.V_REC_ID :1: _record_.V_REC_ID;
  out.V_COLLECTOR_ID :1: _record_.V_COLLECTOR_ID;
  out.V_LOCATION_ID :1: _record_.V_LOCATION_ID;
  out.V_ACCOUNT_NUMBER :1: _record_.V_ACCOUNT_NUMBER;
  out.D_PROMISE_TAKEN_DATE_107 :1: (date("YYYY-MM-DD"))(date("YYYYMMDD"))(string_concat("20",_record_.D_PROMISE_TAKEN_DATE_107));
  out.V_PROMISE_TAKEN_STATE_107 :1: _record_.V_PROMISE_TAKEN_STATE_107;
  out.V_FILLER :1: _record_.V_FILLER;
  out.* :1: _record_.*;
end;|3|3|c|@{0|}}
