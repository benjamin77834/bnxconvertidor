  out.D_ACTIVITY_DATE :1: (date("YYYY-MM-DD"))(date("YYYYMMDD"))_record_.D_ACTIVITY_DATE;
  out.V_COLLECTION_ACTIVITY_CODE :1: _record_.V_COLLECTION_ACTIVITY_CODE;
  out.V_PLACE_CALLED :1: _record_.V_PLACE_CALLED;
  out.V_PARTY_CONTACTED_CODE :1: _record_.V_PARTY_CONTACTED_CODE;
  out.V_PROMISE_AMT_1 :1: _record_.V_PROMISE_AMT_1;
  out.D_PROMISE_DATE_1 :1: (date("YYYY-MM-DD"))(date("YYYYMMDD"))_record_.D_PROMISE_DATE_1;
  out.V_PROMISE_AMT_2 :1: _record_.V_PROMISE_AMT_2;
  out.D_PROMISE_DATE_2 :1: (date("YYYY-MM-DD"))(date("YYYYMMDD"))_record_.D_PROMISE_DATE_2;
  out.V_EXCUSE_CODE :1: _record_.V_EXCUSE_CODE;
  out.V_TIME_ON_ACCOUNT :1: _record_.V_TIME_ON_ACCOUNT;
  out.V_TIME_OBTAINED :1: _record_.V_TIME_OBTAINED;
  out.V_CACS_STATE_CODE :1: _record_.V_CACS_STATE_CODE;
  out.V_104_ORIG_WORKSTATE :1: _record_.V_104_ORIG_WORKSTATE;
  out.V_FILLER :1: _record_.V_FILLER;
  out.* :1: _record_.*;
end;|3|3|c|@{0|}}
