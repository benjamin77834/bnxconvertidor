out::reformat(in)=
begin
  let rec_t _record_=reinterpret_as(rec_t, in._record_);
   $\{_VRULE_V0S231\}
  out.* :2: in.*;
  out.V_REC_ID :1: _record_.V_REC_ID;
  out.V_COLLECTOR_ID :1: _record_.V_COLLECTOR_ID;
  out.V_LOCATION_ID :1: _record_.V_LOCATION_ID;
  out.V_ACCOUNT_NUMBER :1: _record_.V_ACCOUNT_NUMBER;
  out.V_CRNT_ACCT_CURRENCY :1: _record_.V_CRNT_ACCT_CURRENCY;
  out.N_PAY_AMT :1: _record_.N_PAY_AMT;
  out.D_PROMISE_TAKEN_DATE :1: (date("YYYY-MM-DD"))(date("YYYYMMDD"))(string_concat("20",_record_.D_PROMISE_TAKEN_DATE));
  out.V_PROMISE_TAKEN_STATE :1: _record_.V_PROMISE_TAKEN_STATE;
  out.V_101_ORIG_WORKSTATE :1: _record_.V_101_ORIG_WORKSTATE;
  out.V_FILLER :1: _record_.V_FILLER;
  out.* :1: _record_.*;
end;|3|3|c|@{0|}}
