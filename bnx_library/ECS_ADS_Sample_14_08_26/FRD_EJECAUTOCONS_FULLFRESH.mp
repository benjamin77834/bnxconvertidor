out.Hontacto :: in1.Memo_Time;
out.contact_date :: in1.CONTACT_DATE;
out.call_ind :: "OC";
out.unit_id :: in1.userid;
out.fraud_channel :: "Agent";
out.fraud_indicator :: in1.FRAUD_INDICATOR ;
out.survey_mode :: "N/A"; 
out.op_id2 :: "N/A";
out.group_type :: "27";
out.product_name :: "N/A";
out.process_fraud :: in0.channel;
out.bin :: "N/A";
out.c_type :: "N/A";
out.ind_f :: "N/A";
out.id_card :: in0.card_nbr;
out.agent_country_area :: lookup("Catalogo Ejecutivo", string_lrtrim(in1.userid)).agent_country_area;
out.agent_soeid :: lookup("Catalogo Ejecutivo", string_lrtrim(in1.userid)).agent_soeid;
out.um_soeid :: lookup("Catalogo Ejecutivo", string_lrtrim(in1.userid)).um_soeid;
out.dir_soeid :: lookup("Catalogo Ejecutivo", string_lrtrim(in1.userid)).dir_soeid;
