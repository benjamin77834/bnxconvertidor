{2010501005|XXGpvertex|324|0|914|0|{|{30100001|XXparameter_set|@@@@{{30001002|XXparameter|!prototype_path|$AB_COMPONENTS/Transform/Reformat.mpc|3|2|Pf$|@{0|}}
{30001002|XXparameter|out0_metadata|record
  string("\|") acct_nbr  = NULL("");
  string("\|") FRAUD_INDICATOR  = NULL("");
  string("\|") CONTACT_DATE  = NULL("");
  string("\|") memo_timestamp = NULL("");
  string("\|") userid  = NULL("");
  string("\|") Memo_Time = NULL("");
  string("\|") action_code = NULL("");
  string("\|") dif_day = NULL("");
  string("\\n") mis_date  = NULL("");
end|3|1|l|@{0|}}
{30001002|XXparameter|transform0|/*Reformat operation*/
out::reformat(in)=
begin
out.acct_nbr :: string_suffix(string_lrtrim(in.acct_nbr),16);
out.userid :: string_lrtrim(in.userid);
out.memo_timestamp :: string_substring(string_lrtrim(in.memo_timestamp),1,19);
out.CONTACT_DATE ::  string_substring((string(10))string_prefix(string_lrtrim(in.memo_timestamp),10),1,10)   ;
out.FRAUD_INDICATOR :: if(string_lrtrim(in.action_cd) == "CF") "Fraud" else if (string_lrtrim(in.action_cd) == "CG") "Non Fraud" ;
out.Memo_Time :: string_substring((string(21))string_prefix(string_lrtrim(in.memo_timestamp),21),12,8);
out.action_code :: string_lrtrim(in.action_cd);
out.mis_date :: in.mis_date;
out.dif_day :: if (date_difference_days((datetime("YYYY-MM-DD"))now(),in.memo_timestamp)== 1) "a" else if (date_difference_days((datetime("YYYY-MM-DD"))now(),in.memo_timestamp)== 2) "b" else if (date_difference_days((datetime("YYYY-MM-DD"))now(),in.memo_timestamp)== 3) "c" else "z" ;
end;|3|1|l|@{0|}}
