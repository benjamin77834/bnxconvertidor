out.call_ind :: "OC";
out.unit_id :: "Mexico-FEW-Automated";
out.fraud_channel :: "Automated-SMS";
out.fraud_indicator ::  in0.fraud_indicator  ;
out.survey_mode :: "N/A"; 
out.op_id2 :: "N/A";
out.group_type :: "27";
out.product_name :: lookup("Lookup Catalogo", string_lrtrim(in1.bin)).nombre; 
out.process_fraud :: "3_T" ;
out.bin :: in1.bin;
out.c_type :: lookup("Lookup Catalogo", string_lrtrim(in1.bin)).c_type_catalogo ;
out.ind_f :: "N/A";
out.id_card :: string_lpad(in1.id_card,16,'0') ;
out.memo_time :: in0.memo_time;
out.action_code :: in0.action_code;
out.user_id :: in0.user_id;
out.project_type :: "Automatico";
out.id :: in0.id;
end;|3|1|l|@{0|}}
