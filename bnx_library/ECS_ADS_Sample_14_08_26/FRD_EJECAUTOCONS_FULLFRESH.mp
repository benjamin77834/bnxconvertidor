{30001002|XXparameter|transform|/*Join transform*/
out::join(in0,in1)=
begin
out.survey_type :: "Fraud Early Warning";
out.language_1 :: "Mexico Spanish";
out.memo_timestamp :: in0.memo_timestamp;
out.Hontacto :: in0.Hcontacto;
out.contact_date :: in0.contact_date ;
out.call_ind :: "OC";
out.unit_id :: in0.unit_id;
out.fraud_channel :: "Agent";
out.fraud_indicator ::  in0.fraud_indicator  ;
out.survey_mode :: "N/A"; 
out.op_id2 :: "N/A";
out.group_type :: "27";
out.product_name :: lookup("Lookup Catalogo", string_lrtrim(in1.bin)).nombre; 
out.process_fraud :: "3_T" ;
out.bin :: in1.bin;
out.c_type :: lookup("Lookup Catalogo", string_lrtrim(in1.bin)).c_type_catalogo ;
out.ind_f :: "N/A";
out.id_card :: string_lpad(in1.id_card,16,'0') ;
out.agent_country_area :: lookup("Catalogo Ejecutivo", string_lrtrim(in0.unit_id)).agent_country_area;
out.agent_soeid :: lookup("Catalogo Ejecutivo", string_lrtrim(in0.unit_id)).agent_soeid;
out.um_soeid :: lookup("Catalogo Ejecutivo", string_lrtrim(in0.unit_id)).um_soeid;
out.dir_soeid :: lookup("Catalogo Ejecutivo", string_lrtrim(in0.unit_id)).dir_soeid;
out.agent_site :: lookup("Catalogo Ejecutivo", string_lrtrim(in0.unit_id)).agent_site;
out.agent_site_descr :: lookup("Catalogo Ejecutivo", string_lrtrim(in0.unit_id)).agent_site_descr;
out.agent_dept_descr :: lookup("Catalogo Ejecutivo", string_lrtrim(in0.unit_id)).agent_dept_descr;
out.id :: in0.id;
out.project_type :: "Ejecutivo";
end;|3|1|l|@{0|}}
