{30001002|XXparameter|transform0|/*Reformat operation*/
out::reformat(in)=
begin
out.id :: string_lrtrim(in.vc_alert_id);
out.fraud_indicator :: if(string_lrtrim(in.vc_to_status_name) == "Confirmed Fraud - Non FICO Alert") "Fraud" else if (string_lrtrim(in.vc_to_status_name) == "Confirmed Non Fraud - Non FICO Alert") "Non Fraud" else if (string_lrtrim(in.vc_to_status_name) == "FICO Cancel Confirmed Fraud'") "Fraud" else if (string_lrtrim(in.vc_to_status_name) == "FICO Canceled Confirmed Non Fraud") "Non Fraud" ;
out.contact_date :: string_substring(string_lrtrim(in.t_change_date_time),1,10)  ;
out.Hcontacto ::  string_substring(string_lrtrim(in.t_change_date_time),12,8) ;
out.memo_timestamp :: string_substring(string_lrtrim(in.t_change_date_time),1,19);
out.action_code :: string_lrtrim(in.vc_to_status_name);
out.d_mis_date :: in.d_mis_date;
out.unit_id :: string_lrtrim(in.vc_changing_user_id);
out.dif_day :: if (date_difference_days((datetime("YYYY-MM-DD"))now(),in.t_change_date_time)== 1) "a" else if (date_difference_days((datetime("YYYY-MM-DD"))now(),in.t_change_date_time)== 2) "b" else if (date_difference_days((datetime("YYYY-MM-DD"))now(),in.t_change_date_time)== 3) "c" else "z" ;
end;|3|1|l|@{0|}}
