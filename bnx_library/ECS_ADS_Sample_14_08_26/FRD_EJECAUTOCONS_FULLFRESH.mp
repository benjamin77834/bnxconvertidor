{30001002|XXparameter|transform0|/*Reformat operation*/
out::reformat(in)=
begin
out.acct_nbr :: string_suffix(string_lrtrim(in.acct_nbr),16);
out.card_nbr ::  if(string_lrtrim(in.acct_nbr) == "00000000000000000000" )string_suffix(string_lrtrim(in.acct_nbr),16) else string_suffix(string_lrtrim(in.acct_nbr),16) ;
out.channel :: if(in.channel == 132) "1_B" else if (in.channel == 138) "2_BM" ;
out.mis_date :: in.mis_date;
end;|3|1|l|@{0|}}
{30001002|XXparameter|out0_metadata|record
  string("\|") card_nbr /*VARCHAR(20) CHARACTER SET LATIN NOT NULL*/;
  string("\|") acct_nbr /*VARCHAR(20) CHARACTER SET LATIN NOT NULL*/;
  string("\|") channel = NULL /*INTEGER*/;
  string("\\n") mis_date /*DATE NOT NULL*/;
end|3|1|l|@{0|}}
