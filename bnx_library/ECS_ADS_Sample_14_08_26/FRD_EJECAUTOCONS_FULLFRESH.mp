{2010501005|XXGpvertex|130|0|289|0|{|{30100001|XXparameter_set|@@@@{{30001002|XXparameter|!prototype_path|$AB_COMPONENTS/Transform/Reformat.mpc|3|2|Pf$|@{0|}}
{30001002|XXparameter|transform0|/*Reformat operation*/
let decimal(15) tot_rec_count=1;
out::reformat(in)=

begin
if(next_in_sequence()>0)
 begin 
 tot_rec_count = tot_rec_count + 1 ;
 end;
out.survey_type :: in.survey_type;
out.language_1 :: in.language_1;
out.memo_timestamp :: in.memo_timestamp;
out.Hontacto :: in.Hontacto;
out.contact_date :: in.contact_date;
out.call_ind :: in.call_ind;
out.unit_id :: in.unit_id;
out.fraud_channel :: in.fraud_channel;
out.fraud_indicator :: in.fraud_indicator;
out.survey_mode :: in.survey_mode;
out.op_id2 :: in.op_id2;
out.group_type :: in.group_type;
out.product_name :: in.product_name;
out.process_fraud :: in.process_fraud;
out.bin :: in.bin;
out.c_type :: in.c_type;
out.ind_f :: in.ind_f;
out.id_card :: in.id_card;
out.agent_country_area :: in.agent_country_area;
out.agent_soeid :: in.agent_soeid;
out.um_soeid :: in.um_soeid;
out.dir_soeid :: in.dir_soeid;
out.agent_site :: in.agent_site;
out.agent_site_descr :: in.agent_site_descr;
out.agent_dept_descr :: in.agent_dept_descr;
out.project_type :: in.project_type;
out.cuentitas :: string_lrtrim(tot_rec_count);
out.week :: date_week_of_year((date("YYYY-MM-DD"))in.contact_date);
out.day :: date_day_of_month((date("YYYY-MM-DD"))in.contact_date);
out.year :: date_year((date("YYYY-MM-DD"))in.contact_date);
out.month :: date_month((date("YYYY-MM-DD"))in.contact_date);
end;|3|1|l|@{0|}}
