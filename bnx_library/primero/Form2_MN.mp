  //decimal("\\x01") num_sucoperadora /*INTEGER NOT NULL*/;
  //decimal("\\x01".2, maximum_length=18, sign_reserved) imp_transaccion /*DECIMAL(16,2) NOT NULL*/;
  //decimal("\\x01") num_producto /*SMALLINT NOT NULL*/;
