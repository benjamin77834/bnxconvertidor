{2010501005|XXGpvertex|1752|0|5348|0|{|{30100001|XXparameter_set|@@@@{{30001002|XXparameter|!prototype_path|$AB_COMPONENTS/Transform/Rollup.mpc|3|2|Pf$|@{0|}}
{30001002|XXparameter|transform|out :: rollup(in) =
begin
  out.institucion :: in.institucion;
  out.fecha :: (date("YYYY/MM/DD"))(date("YYYY-MM-DD"))$FZWM3FHPROC;
  out.tipo_operacion :: in.tipo_operacion;
  out.sucursal :: in.sucursal;
  out.clabe :: in.clabe;
  out.tipo_cuenta :: in.tipo_cuenta;
  out.nivel_cuenta :: in.nivel_cuenta;
  out.tipo_cliente :: in.tipo_cliente;
  out.importe::decimal_round( sum(in.importe), 0 );
  out.num_operaciones::sum( in.num_operaciones);
end;|3|1|l|@{0|}}
