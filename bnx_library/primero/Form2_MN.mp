{30001002|XXparameter|transform0|/*Reformat operation*/
out::reformat(in)=
begin

out.*::in.*;
  out.tipo_cuenta ::   (string_lrtrim(first_defined(in.es_bin_clasificado, 'N')) == 'Y') ? in.tipo_cuenta  :    (string_lrtrim(in.CLABE) != 'NA') ? in.tipo_cuenta : (lookup_match("CAT1503LKP_SIS",in.cve_txn)) ? (in.tipo_cuenta == 13) ? in.tipo_cuenta :
       first_defined(lookup("CAT1503LKP_SIS",in.cve_txn).tipo_cuenta, in.tipo_cuenta) : (lookup_match("LKP_OBM",in.tipo_operacion)) ?
         ((!is_null(lookup("LKP_OBM",in.tipo_operacion).tipo_cuenta_dinerosuc)) && (string_lrtrim(in.null_dinerosuc) == 'F')) ? lookup("LKP_OBM",in.tipo_operacion).tipo_cuenta_dinerosuc :
             first_defined(lookup("LKP_OBM",in.tipo_operacion).tipo_cuenta, in.tipo_cuenta) :  in.tipo_cuenta  ;
  
  
  
  //out.nivel_cuenta :: in.nivel_cuenta;
  //out.nivel_cuenta ::(lookup_match("CAT1503LKP_OBM",in.cve_txn)) ?  first_defined(lookup("CAT1503LKP_OBM",in.cve_txn).nivel_cuenta, in.nivel_cuenta) :  in.nivel_cuenta  ;
  out.nivel_cuenta :: (string_lrtrim(first_defined(in.es_bin_clasificado, 'N')) == 'Y') ? in.nivel_cuenta :    (string_lrtrim(first_defined(in.hay_nivel_transfer_captacion, 'N')) == 'Y') ? in.nivel_cuenta :   
                            (lookup_match("LKP_OBM",in.tipo_operacion)) ?  
      ((!is_null(lookup("LKP_OBM",in.tipo_operacion).nivel_cuenta_dinerosuc)) && (string_lrtrim(in.null_dinerosuc) == 'F')) ? lookup("LKP_OBM",in.tipo_operacion).nivel_cuenta_dinerosuc : 
        first_defined(lookup("LKP_OBM",in.tipo_operacion).nivel_cuenta, in.nivel_cuenta) :  in.nivel_cuenta  ;
 
 
  
  //out.tipo_cliente :: in.tipo_cliente ;
  //out.tipo_cliente :: (string_lrtrim(in.CLABE) != 'NA') ? in.tipo_cliente :  (lookup_match("CAT1503LKP_SIS",in.cve_txn)) ?  first_defined(lookup("CAT1503LKP_SIS",in.cve_txn).tipo_cliente, in.tipo_cliente) : (lookup_match("CAT1503LKP_OBM",in.cve_txn)) ?  first_defined(lookup("CAT1503LKP_OBM",in.cve_txn).tipo_cliente, in.tipo_cliente) :  in.tipo_cliente  ;
  out.tipo_cliente ::  (string_lrtrim(first_defined(in.es_bin_clasificado, 'N')) == 'Y') ? in.tipo_cliente   :  (string_lrtrim(in.CLABE) != 'NA') ? in.tipo_cliente :  (lookup_match("CAT1503LKP_SIS",in.cve_txn)) ?  first_defined(lookup("CAT1503LKP_SIS",in.cve_txn).tipo_cliente, in.tipo_cliente) :
   (lookup_match("LKP_OBM",in.tipo_operacion)) ?  
    ((!is_null(lookup("LKP_OBM",in.tipo_operacion).tipo_cliente_dinerosuc)) && (string_lrtrim(in.null_dinerosuc) == 'F')) ? lookup("LKP_OBM",in.tipo_operacion).tipo_cliente_dinerosuc :
     first_defined(lookup("LKP_OBM",in.tipo_operacion).tipo_cliente, in.tipo_cliente) :  in.tipo_cliente  ;
end;|3|1|l|@{0|}}
