  string(1) erase;
  string(3) accion;
  decimal(18,2,zerofill) imp_transaccion_real;
  decimal("\\x01") cve_naturalezatxn /*SMALLINT NOT NULL*/;
   //  utf8 string("\\x01", maximum_length=6) cve_obm_txnorig1 = NULL("") /*CHAR(3) CHARACTER SET LATIN NOT NULL*/;
     decimal("\\x01",0) subarea /*SMALLINT NOT NULL*/;

string(2) divisas;

  utf8 string("\\x01", maximum_length=80) nomsucdep /*CHAR(40) CHARACTER SET LATIN NOT NULL*/;
  utf8 string("\\x01", maximum_length=80) nomsubarea /*CHAR(40) CHARACTER SET LATIN NOT NULL*/;
    decimal("\\x01".2, maximum_length=18, sign_reserved) imp_tipocambiotxn /*DECIMAL(16,2) NOT NULL*/;
    string(1) erase_comision;
end|3|1|l|@{0|}}
{30001002|XXparameter|transform|out :: join(in0, in1) =
begin
  out.* :: in0.*;
  out.accion::in1.accion;
  out.erase:: if (in1.divisas == '10') 'e' else 
  
  switch(in1.accion)
        case '100' : if (string_lrtrim(in0.cve_ext_virtual) == 'P') 'w' else 'e' ;
        case '101' : if (string_lrtrim(in0.cve_ext_virtual) == 'N' && not (in0.cve_txnsistema == 29996 \|\| in0.cve_txnsistema == 30008) ) 'w' else 'e' ;
        case '110' : if (string_lrtrim(in0.cve_ext_virtual) == 'P') 'w' else 'e' ;
        case '111' : if (string_lrtrim(in0.cve_ext_virtual) == 'N') 'w' else 'e' ;
        case '200' : if (string_lrtrim(in0.cve_ext_virtual) == 'P') 'w' else 'e' ;
        case '201' : if (string_lrtrim(in0.cve_ext_virtual) == 'N' && not (in0.cve_txnsistema == 29996 \|\| in0.cve_txnsistema == 30008) && not (in0.cve_naturalezatxn == in1.cve_naturalezatxn_partida)) 'w' else 'e' ;
        case '210' : if (string_lrtrim(in0.cve_ext_virtual) == 'P') 'w' else 'e' ;
        case '211' : if (string_lrtrim(in0.cve_ext_virtual) == 'P') 'w' else 'e' ;
        default : 'e';
       end;
  //out.imp_transaccion::if (in1.accion=='201' && string_lrtrim(in0.cve_ext)=='N' && not (in0.cve_txnsistema == 29996 \|\| in0.cve_txnsistema == 30008)) in1.importe_partida else in0.imp_transaccion;
  out.imp_transaccion::if (in1.accion=='201' && string_lrtrim(in0.cve_ext)=='N' && not (in0.cve_txnsistema == 29996 \|\| in0.cve_txnsistema == 30008) && in0.imp_transaccion == in1.max_imp_cpartida && in0.num_txnorigen == in1.max_num_txnorigen_cpartida) (in0.imp_transaccion - in1.importe_partida_virtual) else in0.imp_transaccion;
  out.imp_transaccion_real::in0.imp_transaccion;
  
  out.cve_txn:: if (decimal_strip(in1.divisas) > 10) in1.cve_txn_txnorig1 else in0.cve_txn;
  out.num_cuenta::  if (decimal_strip(in1.divisas) > 10) in1.num_cuenta_txnorig1 else in0.num_cuenta;
  out.cve_obm::  if (decimal_strip(in1.divisas) > 10) in1.cve_obm_txnorig1 else in0.cve_obm;
  
  
  out.divisas::in1.divisas;
  out.imp_tipocambiotxn::0;
  out.erase_comision::'e';
end;|3|1|l|@{0|}}
