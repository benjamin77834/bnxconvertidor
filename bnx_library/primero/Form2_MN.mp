{2010501005|XXGpvertex|284|0|726|0|{|{30100001|XXparameter_set|@@@@{{30001002|XXparameter|!prototype_path|$AB_COMPONENTS/Transform/Rollup.mpc|3|2|Pf$|@{0|}}
{30001002|XXparameter|key|\{fec_transaccion; num_caja; num_operacion; num_operador; num_sucoperadora\}|3|2|$|@{0|}}
{30001002|XXparameter|out_metadata|/*\{fec_transaccion; num_caja; num_operacion; num_operador; num_sucoperadora; cve_ext\}*/

record
  date("YYYY-MM-DD")("\\x01") fec_transaccion /*DATE NOT NULL*/;
  decimal("\\x01") num_caja /*SMALLINT NOT NULL*/;
  decimal("\\x01") num_operacion /*INTEGER NOT NULL*/;
  decimal("\\x01") num_operador /*INTEGER NOT NULL*/;
  decimal("\\x01") num_sucoperadora /*INTEGER NOT NULL*/;
  utf8 string("\\x01", maximum_length=3) cve_ext = NULL("") /*VARCHAR(1) CHARACTER SET UNICODE*/;
  decimal(1) hay_mon_nacional;
  decimal(1) hay_mon_extranjera;
  //lg78522 Se agrega campo para validar partidas y contrapartdias en 1 paso
  decimal(1) grupo_valido;
end|3|1|l|@{0|}}
{30001002|XXparameter|transform|out :: rollup(in) =
begin
  out.fec_transaccion :: in.fec_transaccion;
  out.num_operacion :: in.num_operacion;
  out.num_operador :: in.num_operador;
  out.num_sucoperadora :: in.num_sucoperadora;
  out.cve_ext :: in.cve_ext;
  out.num_caja :: in.num_caja;
  out.hay_mon_nacional :: if (min(in.cve_monedasistema) == 1) 1 else 0;
  out.hay_mon_extranjera:: if (max(in.cve_monedasistema) == 2) 1 else 0;
  out.grupo_valido :: string_compare(max(in.cve_ext_real) ,min(in.cve_ext_real)) ;
  
  
end;

// Las claves \{fec_transaccion; num_caja; num_operacion; num_operador; num_sucoperadora; cve_ext\} corresponden a un "grupo de operacions"
// Para que un grupo de operaciones sea v�lido, debe tener un registro tipo partida (cve_ext == 'P') y uno contrapartida (cve_ext == 'N') 
// se hace rollup por las claves y cve_ext para con poder filtrar los grupos que no son v�lidos

out :: output_select(out) =
begin
  out :1: out.hay_mon_nacional == 1 && out.grupo_valido == 1;
end;
out :: input_select(in) =
begin
  out :: in.cve_monedasistema==1;
end;|3|1|l|@{0|}}
