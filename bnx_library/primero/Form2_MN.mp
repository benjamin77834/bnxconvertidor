{30001002|XXparameter|transform0|/*Join transform*/
out::reformat(in0)=
begin
        out.fec_transaccion :: in0.fec_transaccion;
        out.num_caja :: in0.num_caja;
        out.num_operacion :: in0.num_operacion;
        out.num_operador :: in0.num_operador;
        out.num_sucoperadora :: in0.num_sucoperadora;
        out.cve_txnsistema :: in0.cve_txnsistema;        
        out.CLABE :: 'NA';
         //out.tipo_operacion :: in0.cve_obm;
         
         //out.tipo_operacion ::  in0.cve_obm;
         out.sucursal :: in0.num_sucoperadora;
         out.cve_ext :: in0.cve_ext;
         out.tipo_cliente :: if (string_lrtrim(in0.null_dinerosuc)  == 'F' && in0.num_cuenta == 0) '02' else '01';
       
         //out.tipo_cuenta :: 6;
   // out.nivel_cuenta :1: if (is_null(in1.num_cuenta)) '00' else  if (!is_null(in1.hay_nivel_cuenta)) in1.nivel_de_cuenta   else  if (( string_compare(in1.tienda4, '9999') \|\| string_compare(in1.tienda4, '7777')  ) && !is_null(in1.nivel_de_cuenta))     if (in1.hay_nivel_cuenta=='N') '02' else in1.nivel_de_cuenta  else '02' ;
         //out.nivel_cuenta::'02';
         out.nivel_cuenta::if (is_null(lookup("ROWS_BIN -FILE-",decimal_strip(in0.num_sexta)).id_tipo)) '04' else if (string_lrtrim(lookup("ROWS_BIN -FILE-",decimal_strip(in0.num_sexta)).tipo) != 'DEBITO') '04' else '02' ;
         
  out.importe :: in0.imp_transaccion;
  out.cve_monedasistema :: in0.cve_monedasistema;
  

  out.num_txnorigen :: in0.num_txnorigen;
  out.num_sistemaorigtxn :: in0.num_sistemaorigtxn;
  out.num_operacionalfan :: in0.num_operacionalfan;
  out.num_autransaccion :: in0.num_autransaccion;
  out.num_referenciatxn :: in0.num_referenciatxn;
  out.num_cuenta :: in0.num_cuenta;
  out.cve_txn :: in0.cve_txn;
    out.cuenta_p_clabe :: '';
  out.plaza::'NA';
  out.num_sucpromtoracta::in0.num_sucpromtoracta;
    //out.hay_nivel_cuenta :: if (is_null(in1.num_cuenta)) 'N' else 'Y';
    //out.hay_nivel_cuenta :: 'N';
    
     out.hay_nivel_cuenta::if (is_null(lookup("ROWS_BIN -FILE-",decimal_strip(in0.num_sexta)).id_tipo)) 'Y' else if (string_lrtrim(lookup("ROWS_BIN -FILE-",decimal_strip(in0.num_sexta)).tipo) != 'DEBITO') 'Y' else 'N' ;
    
    
         out.tipo_cuenta :: if (is_null(lookup("ROWS_BIN -FILE-",decimal_strip(in0.num_sexta)).id_tipo)) 6 else 
                              switch(string_lrtrim(lookup("ROWS_BIN -FILE-",decimal_strip(in0.num_sexta)).tipo)) 
                                case 'CREDITO' : 6;
                                case 'ESPECIAL' : 6;
                                case 'DEBITO' : 1;
                                default : 1;
                            end;
         out.tipo_operacion :: if (is_null(lookup("ROWS_BIN -FILE-",decimal_strip(in0.num_sexta)).id_tipo)) in0.cve_obm else 
                                 if (is_null(in0.cve_par)) in0.cve_obm else
                                switch(decimal_strip(in0.cve_par)) 
                                 //case 2 : if (string_lrtrim(lookup("ROWS_BIN -FILE-",decimal_strip(in0.num_sexta)).tipo) == 'DEBITO' ) 2 else in0.cve_obm; 
                                 //case 3 : if (string_lrtrim(lookup("ROWS_BIN -FILE-",decimal_strip(in0.num_sexta)).tipo) == 'DEBITO' ) 102 else in0.cve_obm; 
                                 case 2 : if ((string_lrtrim(lookup("ROWS_BIN -FILE-",decimal_strip(in0.num_sexta)).tipo) == 'CREDITO' )\|\|(string_lrtrim(lookup("ROWS_BIN -FILE-",decimal_strip(in0.num_sexta)).tipo) == 'ESPECIAL' )) in0.cve_obm else 2; 
                                 case 3 : if ((string_lrtrim(lookup("ROWS_BIN -FILE-",decimal_strip(in0.num_sexta)).tipo) == 'CREDITO' )\|\|(string_lrtrim(lookup("ROWS_BIN -FILE-",decimal_strip(in0.num_sexta)).tipo) == 'ESPECIAL' )) in0.cve_obm else 102 ; 
                                 default : in0.cve_obm;
                               end;
                               
                               
          out.es_bin_clasificado:: ( !is_null(lookup("ROWS_BIN -FILE-",decimal_strip(in0.num_sexta)).id_tipo  )) ? 'Y' : 'N' ;
                               
                               
        out.imp_transaccion_real::in0.imp_transaccion_real;
  out.cve_naturalezatxn :: in0.cve_naturalezatxn;
  out.subarea :: in0.subarea;
  out.divisas :: in0.divisas;
        out.nomsubarea::in0.nomsubarea;
  out.nomsucdep::in0.nomsucdep;
  out.imp_tipocambiotxn::in0.imp_tipocambiotxn;
  out.null_dinerosuc::in0.null_dinerosuc;
end;

