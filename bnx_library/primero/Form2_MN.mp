{30001002|XXparameter|transform|out :: join(in0, in1) =
begin
  out.fec_transaccion :: in0.fec_transaccion;
  out.num_caja :: in0.num_caja;
  out.num_operacion :: in0.num_operacion;
  out.num_operador :: in0.num_operador;
  out.num_sucoperadora :: in0.num_sucoperadora;
  //out.accion:: string_concat((string(1))in0.solo_partidas, (if(in0.cant_operaciones == 1 && in1.cant_operaciones == 1) '1' else '0'), (if (in0.sum_importes == in1.sum_importes) '1' else '0'));
  
  out.accion::if (in0.sum_importes == in1.sum_importes) '1' else '0';
  //accion
  //1 : Sumatoria de partidas igual a sumatoria de contrapartidas
  //0 : Sumatoria de partidas desigual a sumatoria de contrapartidas
  //
  
  out.importe_partida:: if(in0.solo_partidas == 2 && in0.sum_importes==in1.sum_importes) in0.importe_partida else 0;
  out.cve_naturalezatxn_partida :: in0.cve_naturalezatxn;
  out.importe_partida_virtual::in0.importe_partida_virtual;
  out.max_imp_cpartida::in1.max_imp_cpartida;
  out.max_num_txnorigen_cpartida::in1.max_num_txnorigen_cpartida;
  
    out.divisas::string_concat((if((in0.hay_divisas_p + in1.hay_divisas_c) > 0) '1' else '0'), (if (in0.sum_importes == in1.sum_importes) '1' else '0'));
  
    out.cve_txn_txnorig1:: if (in0.hay_txnorig1 == 1 ) in0.cve_txn_txnorig1_p else in1.cve_txn_txnorig1_c ;
    out.num_cuenta_txnorig1:: if (in0.hay_txnorig1 == 1 ) in0.num_cuenta_txnorig1_p else in1.num_cuenta_txnorig1_c ;
    out.cve_obm_txnorig1:: if (in0.hay_txnorig1 == 1 ) in0.cve_obm_txnorig1 else in1.cve_obm_txnorig1 ;
  out.ops_siete:: (in0.ops_siete + in1.ops_siete);
  out.imp_siete::in1.imp_siete;
  out.imp_siete_cheque::in1.imp_siete_cheque;
  out.imp_partida_real::in0.importe_partida - in0.importe_partida_virtual;
      out.imp_tipocambiotxn::in0.imp_tipocambiotxn + in1.imp_tipocambiotxn ;
   
   
   out._300_flag_reporta:: (in0._300_importe_sin_300 == in1._300_importe_sin_300) ? 1 : 0; 
   out._300_imp_partida_real::in0._300_imp_partida_real;
   out._300_importe_comision::in1._300_importe_comision;
   
 // decimal("\\x01".2, maximum_length=18, sign_reserved) _300_importe_comision_partida /*DECIMAL(16,2) NOT NULL*/;
 // decimal(1) hay_comision_00;
 // decimal(1) hay_comision_02;
 // decimal(1) hay_comision_03;
   out._300_importe_comision_partida:: in0._300_importe_comision_partida;
   
   out.hay_comision_00::in1.hay_comision_00;
   out.hay_comision_02::in0.hay_comision_02;
   out.hay_comision_03::in0.hay_comision_03;
   
   out._300_importe_comision_real:: (in1._300_importe_comision == 0 )?  in0._300_importe_comision_partida :in1._300_importe_comision;
   
   out._300_importe_cambio::in0._300_importe_cambio + in1._300_importe_cambio ;
end;|3|1|l|@{0|}}
