{30001002|XXparameter|out_metadata|// fec_transaccion; num_caja; num_operacion; num_operador; num_sucoperadora\}

record
  date("YYYY-MM-DD") fec_transaccion /*DATE NOT NULL*/;
  decimal("\\x01") num_caja /*SMALLINT NOT NULL*/;
  decimal("\\x01") num_operacion /*INTEGER NOT NULL*/;
  decimal("\\x01") num_operador /*INTEGER NOT NULL*/;
  decimal("\\x01") num_sucoperadora /*INTEGER NOT NULL*/;
  decimal("\\x01".2) sum_importes /* Sumatoria de los importes */;
  decimal("\\x01") cant_operaciones /* Cantidad de operaciones para misma llave */;
  //string(1) max_cve_ext /*VARCHAR(1) CHARACTER SET UNICODE*/;
  //string(1) min_cve_ext /*VARCHAR(1) CHARACTER SET UNICODE*/;
  decimal(1) solo_partidas /* 1> solo partidas, 0> partidas y virtuales*/;
  //    de muestra
  //decimal("\\x01") cve_txnsistema /*INTEGER NOT NULL*/;
  //decimal("\\x01") num_caja /*SMALLINT NOT NULL*/;
  //decimal("\\x01") num_operacion /*INTEGER NOT NULL*/;
  //decimal("\\x01") num_operador /*INTEGER NOT NULL*/;
  //decimal("\\x01") num_sucoperadora /*INTEGER NOT NULL*/;
  //decimal("\\x01".2, maximum_length=18, sign_reserved) imp_transaccion /*DECIMAL(16,2) NOT NULL*/;
  //decimal("\\x01") num_producto /*SMALLINT NOT NULL*/;
  //decimal("\\x01",0, maximum_length=21) num_cuenta /*DECIMAL(20) NOT NULL*/;
  //decimal("\\x01",0, maximum_length=16) num_sucpromtoracta /*DECIMAL(15) NOT NULL*/;
  //utf8 string("\\x01", maximum_length=6) cve_obm /*CHAR(3) CHARACTER SET LATIN NOT NULL*/;
  //utf8 string("\\x01", maximum_length=3) cve_ext = NULL("") /*VARCHAR(1) CHARACTER SET UNICODE*/;
  //decimal(6) num_sexta ;
  //utf8 string("\\x01", maximum_length=2) null_cuenta = NULL("") /*CHAR(1) CHARACTER SET LATIN*/;
  //
  //utf8 string("\\x01", maximum_length=3) null_dinerosuc = NULL("") /*VARCHAR(1) CHARACTER SET UNICODE*/;
  //decimal("\\x01") cve_monedasistema /*SMALLINT NOT NULL*/;
  //
  //decimal("\\x01") num_txnorigen /*INTEGER NOT NULL*/;
  //decimal("\\x01") num_sistemaorigtxn /*SMALLINT NOT NULL*/;
  //utf8 string("\\x01", maximum_length=24) num_operacionalfan /*CHAR(12) CHARACTER SET LATIN NOT NULL*/;
  //decimal("\\x01") num_autransaccion /*INTEGER NOT NULL*/;
  //utf8 string("\\x01", maximum_length=46) num_referenciatxn /*CHAR(23) CHARACTER SET LATIN NOT NULL*/;
  //utf8 string("\\x01", maximum_length=20) cve_par = NULL("") /*CHAR(10) CHARACTER SET LATIN*/;
  //decimal(10) cve_txn ;
  //string(1) cve_ext_virtual;
  
  
    decimal("\\x01".2) importe_partida;
    decimal("\\x01".2) importe_partida_virtual = 0;
    decimal("\\x01") cve_naturalezatxn /*SMALLINT NOT NULL*/;
       decimal(10) cve_txn_txnorig1_p;
   decimal("\\x01",0, maximum_length=21) num_cuenta_txnorig1_p;
   decimal(4) hay_divisas_p;
      utf8 string("\\x01", maximum_length=6) cve_obm_txnorig1 = NULL("") /*CHAR(3) CHARACTER SET LATIN NOT NULL*/;
   decimal(2) hay_txnorig1;
   
end|3|1|l|@{0|}}
{30001002|XXparameter|transform|out :: rollup(in) =
begin
  out.fec_transaccion :: in.fec_transaccion;
  out.num_caja :: in.num_caja;
  out.num_operacion :: in.num_operacion;
  out.num_operador :: in.num_operador;
  out.num_sucoperadora :: in.num_sucoperadora;
  out.sum_importes :: sum(in.imp_transaccion);
  out.cant_operaciones :: count(in.imp_transaccion);
  out.solo_partidas :: if (max(string_lrtrim(in.cve_ext))==min(string_lrtrim(in.cve_ext))) 1 else 2;
  out.importe_partida :: sum(in.importe_partida);
  out.cve_naturalezatxn :: in.cve_naturalezatxn;
    out.importe_partida_virtual::sum(in.imp_transaccion, in.cve_ext == "N");


out.hay_txnorig1::if (min(in.num_txnorigen) == 1 ) 1 else 0 ;

    out.cve_txn_txnorig1_p    :: max(in.cve_txn_txnorig1);
    out.num_cuenta_txnorig1_p :: max(in.num_cuenta_txnorig1)  ;
    
    out.cve_obm_txnorig1 :: max(in.cve_obm_txnorig1);
    
    out.hay_divisas_p         :: if (sum(in.hay_divisas) >= 1 ) 1 else 0;
   
    
end;|3|1|l|@{0|}}
