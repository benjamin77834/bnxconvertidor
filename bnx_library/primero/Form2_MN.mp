{30001002|XXparameter|transform|out :: rollup(in) =
begin
  out.fec_transaccion :: in.fec_transaccion;
  out.num_caja :: in.num_caja;
  out.num_operacion :: in.num_operacion;
  out.num_operador :: in.num_operador;
  out.num_sucoperadora :: in.num_sucoperadora;
  out.sum_importes :: sum(in.imp_transaccion);
  out.cant_operaciones :: count(in.imp_transaccion);
  //out.solo_partidas :: max(string_lrtrim(in.cve_ext))==min(string_lrtrim(in.cve_ext));
  out.max_imp_cpartida::max(in.imp_transaccion,not (in.cve_txnsistema == 29996 \|\| in.cve_txnsistema == 30008));
  out.max_num_txnorigen_cpartida:: max(in.num_txnorigen, in.imp_transaccion == max(in.imp_transaccion,not (in.cve_txnsistema == 29996 \|\| in.cve_txnsistema == 30008)));



  
  out.hay_txnorig1::if (min(in.num_txnorigen) == 1 ) 1 else 0 ;

    out.cve_txn_txnorig1_c    :: max(in.cve_txn_txnorig1);
    out.num_cuenta_txnorig1_c :: max(in.num_cuenta_txnorig1)  ;
    
    out.cve_obm_txnorig1 :: max(in.cve_obm_txnorig1);
    
    out.hay_divisas_c         :: if (sum(in.hay_divisas) > 1 ) 1 else 0;
    out.ops_siete :: sum(in.ops_siete);
    out.imp_siete::sum(in.imp_siete);
    out.imp_siete_cheque::sum(in.imp_siete_cheque);
        out.imp_tipocambiotxn::sum(in.imp_tipocambiotxn);
        
    out._300_importe_comision::sum(in._300_importe_comision); 
    out._300_importe_sin_300 ::sum(in._300_importe_sin_300) ;
    
      out._300_importe_comision_partida::sum(in._300_importe_comision_partida );
  out.hay_comision_00::sum(in.hay_comision_00);
  out.hay_comision_02::sum(in.hay_comision_02);
  out.hay_comision_03::sum(in.hay_comision_03);
    out._300_importe_cambio::sum(in.imp_transaccion, (in.cve_txnsistema == 29996 \|\| in.cve_txnsistema == 30008));//in.cve_txnsistema == 29996 \|\| in.cve_txnsistema == 30008
end;|3|1|l|@{0|}}
