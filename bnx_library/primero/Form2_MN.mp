  //decimal(10) cve_txn ;
  //string(1) cve_ext_virtual;
  
  
    decimal("\\x01".2) importe_partida;
    decimal("\\x01".2) importe_partida_virtual = 0;
    decimal("\\x01") cve_naturalezatxn /*SMALLINT NOT NULL*/;
    
           decimal(10) cve_txn_txnorig1_p;
   decimal("\\x01",0, maximum_length=21) num_cuenta_txnorig1_p;
   decimal(4) hay_divisas_p;
      utf8 string("\\x01", maximum_length=6) cve_obm_txnorig1 = NULL("") /*CHAR(3) CHARACTER SET LATIN NOT NULL*/;
   decimal(2) hay_txnorig1;
       decimal(4) ops_siete;
   decimal("\\x01".2, maximum_length=18, sign_reserved) imp_siete;
   decimal("\\x01".2, maximum_length=18, sign_reserved) imp_siete_cheque;
   decimal("\\x01".2, maximum_length=18, sign_reserved) imp_tipocambiotxn /*DECIMAL(16,2) NOT NULL*/;
   
     decimal("\\x01".2, maximum_length=18, sign_reserved) _300_imp_partida_real /*DECIMAL(16,2) NOT NULL*/;
  decimal("\\x01".2, maximum_length=18, sign_reserved) _300_importe_sin_300 /*DECIMAL(16,2) NOT NULL*/;
  
      decimal("\\x01".2, maximum_length=18, sign_reserved) _300_importe_comision_partida /*DECIMAL(16,2) NOT NULL*/;
  decimal(1) hay_comision_00;
  decimal(1) hay_comision_02;
  decimal(1) hay_comision_03;
  
  decimal("\\x01".2, maximum_length=18, sign_reserved) _300_importe_cambio = 0;
  
  
end|3|1|l|@{0|}}
{30001002|XXparameter|transform|out :: rollup(in) =
begin
  out.fec_transaccion :: in.fec_transaccion;
  out.num_caja :: in.num_caja;
  out.num_operacion :: in.num_operacion;
  out.num_operador :: in.num_operador;
  out.num_sucoperadora :: in.num_sucoperadora;
  out.sum_importes :: sum(in.imp_transaccion);
  out.cant_operaciones :: count(in.imp_transaccion);
  out.solo_partidas :: if (max(string_lrtrim(in.cve_ext))==min(string_lrtrim(in.cve_ext))) 1 else 2;
  out.importe_partida :: sum(in.importe_partida);
  out.cve_naturalezatxn :: in.cve_naturalezatxn;
    out.importe_partida_virtual::sum(in.imp_transaccion, in.cve_ext == "N");

out.hay_txnorig1::if (min(in.num_txnorigen) == 1 ) 1 else 0 ;

    out.cve_txn_txnorig1_p    :: max(in.cve_txn_txnorig1);
    out.num_cuenta_txnorig1_p :: max(in.num_cuenta_txnorig1)  ;
    out.cve_obm_txnorig1 :: max(in.cve_obm_txnorig1);
    out.hay_divisas_p         :: if (sum(in.hay_divisas) > 1 ) 1 else 0;
        out.ops_siete :: sum(in.ops_siete);
    out.imp_siete::sum(in.imp_siete);
    out.imp_siete_cheque::sum(in.imp_siete_cheque);
    out.imp_tipocambiotxn::sum(in.imp_tipocambiotxn);
    
    out._300_imp_partida_real::sum(in._300_imp_partida_real);
    out._300_importe_sin_300::sum(in._300_importe_sin_300);
    
  out._300_importe_comision_partida::sum(in._300_importe_comision_partida );
  out.hay_comision_00::sum(in.hay_comision_00);
  out.hay_comision_02::sum(in.hay_comision_02);
  out.hay_comision_03::sum(in.hay_comision_03);
    out._300_importe_cambio::sum(in.imp_transaccion, (in.cve_txnsistema == 29996 \|\| in.cve_txnsistema == 30008));//in.cve_txnsistema == 29996 \|\| in.cve_txnsistema == 30008
end;|3|1|l|@{0|}}
