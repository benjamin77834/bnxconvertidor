  //       ((!is_null(lookup("CAT1503LKP_OBM",in.cve_txn).tipo_cuenta_dinerosuc)) && (string_lrtrim(in.null_dinerosuc) == 'F')) ? lookup("CAT1503LKP_OBM",in.cve_txn).tipo_cuenta_dinerosuc :
