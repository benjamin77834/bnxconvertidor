  //utf8 string("\\x01", maximum_length=6) cve_obm /*CHAR(3) CHARACTER SET LATIN NOT NULL*/;
  //utf8 string("\\x01", maximum_length=3) cve_ext = NULL("") /*VARCHAR(1) CHARACTER SET UNICODE*/;
  //decimal(6) num_sexta ;
  //utf8 string("\\x01", maximum_length=2) null_cuenta = NULL("") /*CHAR(1) CHARACTER SET LATIN*/;
  //
  //utf8 string("\\x01", maximum_length=3) null_dinerosuc = NULL("") /*VARCHAR(1) CHARACTER SET UNICODE*/;
  //decimal("\\x01") cve_monedasistema /*SMALLINT NOT NULL*/;
