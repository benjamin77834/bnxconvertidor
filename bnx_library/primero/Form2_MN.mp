{30001002|XXparameter|transform0|out :: reformat(in) =
begin
  out.* :: in.*;
  //out.num_sucpromtoracta_vip :: in.num_sucpromtoracta;
  //out.num_cuenta_vip:: (decimal(4))in.num_sucpromtoracta * 10000000 + ( (decimal(11))in.num_cuenta % 10000000 );
  out.cuenta_p_clabe:: (string(11))(decimal(11, zerofill))((decimal(4))in.num_sucpromtoracta * 10000000 + ( (decimal(11))in.num_cuenta % 10000000 ));
end;

// se agregan los campos _vip para utilizarse en el grupo de 4 joins a continuaci�n. Acorde especificaci�n:
//	Formatear NUM_CUENTA a un numero de 11 d�gitos, rellenando con ceros a la izquierda de ser necesario
//	Formatear NUM_SUCPROMTORACTA a un numero de 4 d�gitos, rellenando con ceros a la izquierda de ser necesario
//	Sustituir  los primeros 4 d�gitos de NUM_CUENTA con formato de 11 d�gitos por NUM_SUCPROMTORACTA formateada a 4 d�gitos

// Extracto de query que hacia algo similar

//(SUBSTR('0000'\|\|TRIM(TRANSACSUC.NUM_SUCPROMTORACTA), CHARACTER_LENGTH(TRIM(TRANSACSUC.NUM_SUCPROMTORACTA)) + 1,4))
//(SUBSTR('0000'\|\|TRIM(TRANSACSUC.NUM_SUCPROMTORACTA), CHARACTER_LENGTH(TRIM(TRANSACSUC.NUM_SUCPROMTORACTA)) + 1,4))
//	\|\|
//	SUBSTR((SUBSTR('00000000000'\|\|TRIM(TRANSACSUC.NUM_CUENTA), CHARACTER_LENGTH(TRIM(TRANSACSUC.NUM_CUENTA)) + 1,11)), 4, 7) = CTAO.CUENTA
//)|3|1|l|@{0|}}
