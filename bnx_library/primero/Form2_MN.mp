  decimal("\\x01".2) max_imp_cpartida = 0 /* Mayor importe de contrapartida no-vuelto */;
  
    decimal("\\x01") max_num_txnorigen_cpartida = 0 /*INTEGER NOT NULL*/;

  
  decimal("\\x01") cant_operaciones /* Cantidad de operaciones para misma llave */;
