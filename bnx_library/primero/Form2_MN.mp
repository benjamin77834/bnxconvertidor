{30001002|XXparameter|transform0|/*Reformat operation*/
out::reformat(in)=
begin
out.*::in.*;
out.cve_txn_txnorig1:: if (in.num_txnorigen == 1) in.cve_txn else 0;
out.num_cuenta_txnorig1 :: if (in.num_txnorigen == 1) in.num_cuenta else 0;
out.cve_obm_txnorig1 :: if (in.num_txnorigen == 1) in.cve_obm else "";

out.imp_tipocambiotxn::  if (in.cve_monedasistema != 1) in.imp_transaccion else 0;
out.hay_divisas :: if (in.cve_monedasistema != 1) 1 else 0;
out.imp_transaccion :: if (in.cve_monedasistema != 1) 0 else in.imp_transaccion;
out.ops_siete :: if (decimal_strip(first_defined(in.cve_par,'')) != 5) 0 else 1;
out.imp_siete :: if (is_null(in.cve_par)) 0 else  if (string_lrtrim(in.cve_ext) == 'N' && (decimal(20))decimal_strip(in.cve_par) == 4 ) in.imp_transaccion else 0;
out.imp_siete_cheque :: if (is_null(in.cve_par)) 0 else  if (string_lrtrim(in.cve_ext) == 'N' && (decimal(20))decimal_strip(in.cve_par) == 5 ) in.imp_transaccion else 0;

end;|3|1|l|@{0|}}
