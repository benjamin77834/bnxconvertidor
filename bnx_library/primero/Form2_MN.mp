  //decimal("\\x01") num_producto /*SMALLINT NOT NULL*/;
  //decimal("\\x01",0, maximum_length=21) num_cuenta /*DECIMAL(20) NOT NULL*/;
  //decimal("\\x01",0, maximum_length=16) num_sucpromtoracta /*DECIMAL(15) NOT NULL*/;
  //utf8 string("\\x01", maximum_length=6) cve_obm /*CHAR(3) CHARACTER SET LATIN NOT NULL*/;
  //utf8 string("\\x01", maximum_length=3) cve_ext = NULL("") /*VARCHAR(1) CHARACTER SET UNICODE*/;
  //decimal(6) num_sexta ;
