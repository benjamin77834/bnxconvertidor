{2010501005|XXGpvertex|439|0|1198|0|{|{30100001|XXparameter_set|@@@@{{30001002|XXparameter|!prototype_path|$AB_COMPONENTS/Transform/Reformat.mpc|3|2|Pf$|@{0|}}
{30001002|XXparameter|out0_metadata|record
  date("YYYY-MM-DD")("\\x01") fec_transaccion /*DATE NOT NULL*/;
  decimal("\\x01") num_caja /*SMALLINT NOT NULL*/;
  decimal("\\x01") num_operacion /*INTEGER NOT NULL*/;
  decimal("\\x01") num_operador /*INTEGER NOT NULL*/;
  decimal("\\x01") num_sucoperadora = (0) /*INTEGER NOT NULL*/;

  decimal(3) tipo_operacion;
  decimal(20, zerofill) sucursal;
  string(18) CLABE;
  decimal(2) tipo_cuenta  ;
  
  decimal(2) tipo_cliente;
  decimal(15, zerofill) importe;
  utf8 string("\\x01", maximum_length=3) cve_ext = NULL("") /*VARCHAR(1) CHARACTER SET UNICODE*/;
    decimal("\\x01") cve_txnsistema /*INTEGER NOT NULL*/;
    
    decimal("\\x01") cve_monedasistema /*SMALLINT NOT NULL*/;
    
  decimal("\\x01") num_txnorigen /*INTEGER NOT NULL*/;
  decimal("\\x01") num_sistemaorigtxn /*SMALLINT NOT NULL*/;
  utf8 string("\\x01", maximum_length=24) num_operacionalfan /*CHAR(12) CHARACTER SET LATIN NOT NULL*/;
  decimal("\\x01") num_autransaccion /*INTEGER NOT NULL*/;
  utf8 string("\\x01", maximum_length=46) num_referenciatxn /*CHAR(23) CHARACTER SET LATIN NOT NULL*/;

 decimal("\\x01",0, maximum_length=21) num_cuenta /*DECIMAL(20) NOT NULL*/;
 decimal(10) cve_txn ;
 decimal(2, zerofill) nivel_cuenta;
   decimal("\\x01",0, maximum_length=16) num_sucpromtoracta /*DECIMAL(15) NOT NULL*/;
  decimal(18,2,zerofill) imp_transaccion_real;
    decimal(12) numcliente /*DECIMAL(12) NOT NULL*/;
      decimal("\\x01") cve_naturalezatxn /*SMALLINT NOT NULL*/;
       decimal("\\x01",0) subarea /*SMALLINT NOT NULL*/;

string(2) divisas;
  utf8 string("\\x01", maximum_length=80) nomsucdep /*CHAR(40) CHARACTER SET LATIN NOT NULL*/;
  utf8 string("\\x01", maximum_length=80) nomsubarea /*CHAR(40) CHARACTER SET LATIN NOT NULL*/;
    decimal("\\x01".2, maximum_length=18, sign_reserved) imp_tipocambiotxn /*DECIMAL(16,2) NOT NULL*/;
    utf8 string("\\x01", maximum_length=3) null_dinerosuc = NULL("") /*VARCHAR(1) CHARACTER SET UNICODE*/;
    
    utf8 string("\\x01", maximum_length=3) es_bin_clasificado = NULL("N");
    utf8 string("\\x01", maximum_length=3) hay_nivel_transfer_captacion = NULL("N");
end;|3|1|l|@{0|}}
{30001002|XXparameter|transform0|out :: transform(in) =
begin
        out.fec_transaccion :: in.fec_transaccion;
        out.num_caja :: in.num_caja;
        out.num_operacion :: in.num_operacion;
        out.num_operador :: in.num_operador;
        out.num_sucoperadora :: in.num_sucoperadora;
      
      
        out.CLABE :: 'NA';
         out.cve_txnsistema :: in.cve_txnsistema;        
         out.importe::in.imp_transaccion;
         out.cve_ext :: in.cve_ext;
         out.tipo_operacion :: //in.cve_obm;
                              if (is_null(in.cve_par)) in.cve_obm else
                                switch(decimal_strip(in.cve_par)) 
                                 case 2 :  2; 
                                 case 3 :  102 ; 
                                 default : in.cve_obm;
                               end
;
         
         
         
         out.sucursal :: in.num_sucoperadora;
         
         out.tipo_cliente :: if (string_lrtrim(in.null_dinerosuc)  == 'F' && in.num_cuenta == 0) '02' else '01';
         
         //out.tipo_cuenta :: '0'; //lg78522 Moneada Nacional Fase 2. 2016-09-27 Los tipos de cuenta para las cuentas nulas pasan de ser 4 a 0 
         out.tipo_cuenta ::  '1'; //lg78522 Moneada Nacional 2021. 2021-02-10 El usuario comenta que si no hay cuenta, el tiopo de cuenta debe ser 1.

  out.cve_monedasistema :: in.cve_monedasistema;
  out.num_txnorigen :: in.num_txnorigen;
  out.num_sistemaorigtxn :: in.num_sistemaorigtxn;
  out.num_operacionalfan :: in.num_operacionalfan;
  out.num_autransaccion :: in.num_autransaccion;
  out.num_referenciatxn :: in.num_referenciatxn;
  out.num_cuenta :: in.num_cuenta;
  out.cve_txn :: in.cve_txn;
  out.nivel_cuenta::'04';
  out.num_sucpromtoracta :: in.num_sucpromtoracta;
  out.imp_transaccion_real::in.imp_transaccion_real;
  out.numcliente :: 0;
  out.cve_naturalezatxn :: in.cve_naturalezatxn;
  out.subarea :: in.subarea;
  out.divisas :: in.divisas;
    out.nomsubarea::in.nomsubarea;
  out.nomsucdep::in.nomsucdep;
  out.imp_tipocambiotxn::in.imp_tipocambiotxn;
  out.null_dinerosuc::in.null_dinerosuc;
end;

//6.	Tipo de Cuenta: Seleccionar los valores del campo BIN del Cat�logo EE1DQSPT001615 cuando el campo STATBIN tenga valor 'A'.
//6.1.	Evaluar si el campo NUM_CUENTA contiene 16 caracteres:
//6.1.1	Cuando las primeras seis posiciones del campo NUM_CUENTA tenga el mismo valor del campo BIN, se deber� reportar con valor '6'.
//6.1.2	En caso de que las primeras seis posiciones del campo NUM_CUENTA no tengan el mismo valor del campo BIN, se deber� reportar con valor '1'.
//6.2.	Cuando el valor del campo NUM_CUENTA tenga menos 16 caracteres se deber� reportar con valor '1'.
//6.3.	Cuando el valor del campo NUM_CUENTA no tenga valor se deber� reportar con valor '22'.




//3.	Tipo de Operaci�n: Seleccionar los valores del cat�logo EE1DOIPT001503 cuando el campo CVE_PAE tenga valor '05' para las Operaciones de Sucursales.
//3.1.	Identificar el valor del campo CVE_TXNSISTEMA de la Tabla FZ1DB2TRANSACSUC sea el mismo que el campo CVE_TXN del cat�logo EE1DOIPT001503.
//3.2.	Asignar el valor del campo CVE_OBM del cat�logo EE1DOIPT001503.
//3.3.	En caso de no encontrar alg�n valor se deber� de reportar como '099'.
