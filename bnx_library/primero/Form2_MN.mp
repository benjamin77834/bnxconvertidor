{30001002|XXparameter|out_metadata|// fec_transaccion; num_caja; num_operacion; num_operador; num_sucoperadora\}

record
  date("YYYY-MM-DD") fec_transaccion /*DATE NOT NULL*/;
  decimal("\\x01") num_caja /*SMALLINT NOT NULL*/;
  decimal("\\x01") num_operacion /*INTEGER NOT NULL*/;
  decimal("\\x01") num_operador /*INTEGER NOT NULL*/;
  decimal("\\x01") num_sucoperadora /*INTEGER NOT NULL*/;
  decimal("\\x01".2) sum_importes /* Sumatoria de los importes */;
  decimal("\\x01") cant_operaciones /* Cantidad de operaciones para misma llave */;
  //string(1) max_cve_ext /*VARCHAR(1) CHARACTER SET UNICODE*/;
  //string(1) min_cve_ext /*VARCHAR(1) CHARACTER SET UNICODE*/;
  decimal(1) solo_partidas /* 1> solo partidas, 0> partidas y virtuales*/;
