begin
out.*::in.*;
out.cve_ext_virtual::'P';
out.importe_partida::if (string_lrtrim(in.cve_ext)=='P') in.imp_transaccion else 0 ;

out._300_importe_comision_partida:: if ((in.cve_txnsistema == 8902) \|\| (in.cve_txnsistema == 8903) ) in.imp_transaccion else 0 ;
out.hay_comision_00:: if (in.cve_txnsistema == 8900)  1 else 0 ;
out.hay_comision_02:: if (in.cve_txnsistema == 8902)  1 else 0 ;
out.hay_comision_03:: if (in.cve_txnsistema == 8903)  1 else 0 ;

end;|3|1|l|@{0|}}
