  decimal("\\x01") cant_operaciones /* Cantidad de operaciones para misma llave */;
  //    no tiene partidas
  //    //string(1) max_cve_ext /*VARCHAR(1) CHARACTER SET UNICODE*/;
  //    //string(1) min_cve_ext /*VARCHAR(1) CHARACTER SET UNICODE*/;
