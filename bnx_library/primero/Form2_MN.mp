{2010501005|XXGpvertex|755|0|2210|0|{|{30100001|XXparameter_set|@@@@{{30001002|XXparameter|!prototype_path|$AB_COMPONENTS/Transform/Reformat.mpc|3|2|Pf$|@{0|}}
{30001002|XXparameter|transform0|out :: transform(in) =
begin
 //       out.fec_transaccion :: in0.fec_transaccion;
 //       out.cve_txnsistema :: in0.cve_txnsistema;
 //       out.num_caja :: in0.num_caja;
 //       out.num_operacion :: in0.num_operacion;
 //       out.num_operador :: in0.num_operador;
 //       out.num_sucoperadora :: in0.num_sucoperadora;
 //       out.importe:: in0.imp_transaccion;
 //       out.num_producto :: in0.num_producto;
 //       out.sucursal:: in0.num_sucpromtoracta;
 //       out.tipo_operacion:: in0.cve_obm;
 //       out.cve_ext :: in0.cve_ext;
 //
 //       
 //       out.CLABE::"NA";
 //
 // out.cve_monedasistema :: in0.cve_monedasistema;
 //
 // out.cve_monedasistema :: in.cve_monedasistema;
 // out.num_txnorigen :: in.num_txnorigen;
 // out.num_sistemaorigtxn :: in.num_sistemaorigtxn;
 // out.num_operacionalfan :: in.num_operacionalfan;
 // out.num_autransaccion :: in.num_autransaccion;
 // out.num_referenciatxn :: in.num_referenciatxn;


        out.fec_transaccion :: in.fec_transaccion;

        out.num_caja :: in.num_caja;
        out.num_operacion :: in.num_operacion;
        out.num_operador :: in.num_operador;
        out.num_sucoperadora :: in.num_sucoperadora;
        out.cve_txnsistema :: in.cve_txnsistema;
        out.CLABE :: 'NA';
        out.importe :: in.imp_transaccion;
         out.tipo_operacion :: in.cve_obm;
         out.sucursal :: in.num_sucoperadora;
         out.tipo_cliente :: if (string_lrtrim(in.null_dinerosuc)  == 'F' && in.num_cuenta == 0) '02' else '01';
         out.cve_ext :: in.cve_ext;
         out.tipo_cuenta :: if (string_length(string_lrtrim((string("\|"))(decimal(20))in.num_cuenta)) > 7)  1 else if (in.num_cuenta == 0) 0 else 1;
         
  out.cve_monedasistema :: in.cve_monedasistema;

  
  out.num_txnorigen :: in.num_txnorigen;
  out.num_sistemaorigtxn :: in.num_sistemaorigtxn;
  out.num_operacionalfan :: in.num_operacionalfan;
  out.num_autransaccion :: in.num_autransaccion;
  out.num_referenciatxn :: in.num_referenciatxn;
  out.num_cuenta :: in.num_cuenta;
  out.cve_txn :: in.cve_txn;
out.nivel_cuenta::'04';
  out.num_sucpromtoracta :: in.num_sucpromtoracta;

out.imp_transaccion_real::in.imp_transaccion_real;
  out.cve_naturalezatxn :: in.cve_naturalezatxn;
  out.numcliente :: 0;
  out.subarea :: in.subarea;
  out.divisas :: in.divisas;
    out.nomsubarea::in.nomsubarea;
  out.nomsucdep::in.nomsucdep;
  out.imp_tipocambiotxn::in.imp_tipocambiotxn;
  out.null_dinerosuc::in.null_dinerosuc;
end;
//(
// Este grupo de joins busca el campo plaza en los archivos LAMDA y LACTA. En caso que joinee, si no hay nada en contendio plaza devuelve NA, significando que 
// el campo CLABE debe contener 'NA'.

// Para el caso de los 2 joins superiores se utilizan num_cuenta y num_sucpromtoracta,
// pero para el caso de los 2 joins inferiores, se utilizan num_cuenta_vip y num_sucpromtoracta_vip, calculados en el reformat anterior tal y como dice la especificaci�n:
//	Formatear NUM_CUENTA a un numero de 11 d�gitos, rellenando con ceros a la izquierda de ser necesario
//	Formatear NUM_SUCPROMTORACTA a un numero de 4 d�gitos, rellenando con ceros a la izquierda de ser necesario
//	Sustituir  los primeros 4 d�gitos de NUM_CUENTA con formato de 11 d�gitos por NUM_SUCPROMTORACTA formateada a 4 d�gitos

// con estos campos se intenta nuevamente buscar la Plaza.

// en el inter�n del cambio de claves de join, se utiliza un sort para cambiar el orden, de forma acorde.

//)

//---Este reformat se encarga de que, en caso de que los joins anteriores no generen un campo plaza, ya sea v�lido o "NA", otorgarles a estos registros que no tienen
// plaza el "NA" para que no se calcule la CLABE, puesto que si no tiene PLAZA, no se calcula CLABE.|3|1|l|@{0|}}
