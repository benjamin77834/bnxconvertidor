{2010501005|XXGpvertex|119|0|237|0|{|{30100001|XXparameter_set|@@@@{{30001002|XXparameter|!prototype_path|$AB_COMPONENTS/Transform/Reformat.mpc|3|2|Pf$|@{0|}}
{30001002|XXparameter|transform0|out :: transform(in) =
begin
        out.fec_transaccion :: in.fec_transaccion;
        out.num_caja :: in.num_caja;
        out.num_operacion :: in.num_operacion;
        out.num_operador :: in.num_operador;
        out.num_sucoperadora :: in.num_sucoperadora;
        out.cve_txnsistema :: in.cve_txnsistema;        
        out.CLABE :: 'NA';
         //out.tipo_operacion :: in.cve_obm;
         
         out.tipo_operacion :: if (is_null(lookup("ROWS_BIN -FILE-",decimal_strip(in.num_sexta)).id_tipo)) in.cve_obm else 
                                 if (is_null(in.cve_par)) in.cve_obm else
                                switch(decimal_strip(in.cve_par)) 
                                 //case 2 : if (string_lrtrim(lookup("ROWS_BIN -FILE-",decimal_strip(in0.num_sexta)).tipo) == 'DEBITO' ) 2 else in0.cve_obm; 
                                 //case 3 : if (string_lrtrim(lookup("ROWS_BIN -FILE-",decimal_strip(in0.num_sexta)).tipo) == 'DEBITO' ) 102 else in0.cve_obm; 
                                 case 2 : if ((string_lrtrim(lookup("ROWS_BIN -FILE-",decimal_strip(in.num_sexta)).tipo) == 'CREDITO' )\|\|(string_lrtrim(lookup("ROWS_BIN -FILE-",decimal_strip(in.num_sexta)).tipo) == 'ESPECIAL' )) in.cve_obm else 2; 
                                 case 3 : if ((string_lrtrim(lookup("ROWS_BIN -FILE-",decimal_strip(in.num_sexta)).tipo) == 'CREDITO' )\|\|(string_lrtrim(lookup("ROWS_BIN -FILE-",decimal_strip(in.num_sexta)).tipo) == 'ESPECIAL' )) in.cve_obm else 102 ; 
                                 default : in.cve_obm;
                               end;


         out.sucursal :: in.num_sucoperadora;
         out.cve_ext :: in.cve_ext;
         out.tipo_cliente :: if (string_lrtrim(in.null_dinerosuc)  == 'F' && in.num_cuenta == 0) '02' else '01';
       
         out.tipo_cuenta :: if (is_null(lookup("ROWS_BIN -FILE-",decimal_strip(in.num_sexta)).id_tipo)) 6 else 
                              switch(string_lrtrim(lookup("ROWS_BIN -FILE-",decimal_strip(in.num_sexta)).tipo)) 
                                case 'CREDITO' : 6;
                                case 'ESPECIAL' : 6;
                                case 'DEBITO' : 1;
                                default : 1;
                            end;
        // out.nivel_cuenta:: if (is_null(lookup("ROWS_BIN -FILE-",decimal_strip(in.num_sexta)).id_tipo)) '04' else 
          out.nivel_cuenta::if (is_null(lookup("ROWS_BIN -FILE-",decimal_strip(in.num_sexta)).id_tipo)) '04' else if (string_lrtrim(lookup("ROWS_BIN -FILE-",decimal_strip(in.num_sexta)).tipo) != 'DEBITO') '04' else '02' ;      
              // if ( lookup("ROWS_BIN -FILE-",decimal_strip(in.num_sexta)).id_tipo == 4 && string_lrtrim(lookup("ROWS_BIN -FILE-",decimal_strip(in.num_sexta)).emisor) == 'BANAMEX'  )  '02'
              // else if( string_lrtrim(lookup("ROWS_BIN -FILE-",decimal_strip(in.num_sexta)).emisor) != 'BANAMEX'  )  '00' else '04'
              //  ;
        // out.hay_nivel_cuenta:: if (not is_null(lookup("ROWS_BIN -FILE-",decimal_strip(in.num_sexta)).emisor) && string_lrtrim(lookup("ROWS_BIN -FILE-",decimal_strip(in.num_sexta)).emisor) == 'BANAMEX') 'Y' else 'N';
         out.hay_nivel_cuenta::if (is_null(lookup("ROWS_BIN -FILE-",decimal_strip(in.num_sexta)).id_tipo)) 'Y' else if (string_lrtrim(lookup("ROWS_BIN -FILE-",decimal_strip(in.num_sexta)).tipo) != 'DEBITO') 'Y' else 'N' ;
         
         
         out.es_bin_clasificado:: ( ((decimal_strip(in.cve_par) == 2) \|\|(decimal_strip(in.cve_par) == 3) ) && !is_null(lookup("ROWS_BIN -FILE-",decimal_strip(in.num_sexta)).id_tipo  )) ? 'Y' : 'N' ;
         
         
  out.importe :: in.imp_transaccion;
  out.cve_monedasistema :: in.cve_monedasistema;
  

  out.num_txnorigen :: in.num_txnorigen;
  out.num_sistemaorigtxn :: in.num_sistemaorigtxn;
  out.num_operacionalfan :: in.num_operacionalfan;
  out.num_autransaccion :: in.num_autransaccion;
