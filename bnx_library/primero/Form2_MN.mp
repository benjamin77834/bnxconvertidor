{2010501005|XXGpvertex|1082|0|3151|0|{|{30100001|XXparameter_set|@@@@{{30001002|XXparameter|!prototype_path|$AB_COMPONENTS/Transform/Reformat.mpc|3|2|Pf$|@{0|}}
{30001002|XXparameter|out0_metadata|/* DML Generated for SQL:   Select 
  b.CUENTABASICA\|\|b.ROLLOVER\|\|b.DIGITO as  NUM_CUENTA
  , SUBSTR (trim(oreplace(to_char(C.RESTCON,'00'),'.',' ')),1,1)AS NIVEL
  
  
  FROM   D_BANAMEX_V_C1.LA1DMDA b, D_BANAMEX_V_C1.LA1DCTA C
  Where 
  
   b.CUENTA = C.CUENTA
  AND SUBSTR(NIVEL,1,1) = '2'
  
  AND C.ESTATUS IN (10,11)
 * On: Tue Nov 30 08:19:11 2021
 */
record
 // utf8 string("\\x01", maximum_length=32) num_cuenta /*CHAR(16) CHARACTER SET LATIN NOT NULL*/;
  decimal("\\x01",0, maximum_length=21) num_cuenta /*DECIMAL(20) NOT NULL*/;
  utf8 string("\\x01", maximum_length=3) nivel = NULL("") /*VARCHAR(1) CHARACTER SET UNICODE*/;
  string(1) newline = "\\n";
end|3|2|$|@{0|}}
{30001002|XXparameter|transform0|/*Reformat operation*/
out::reformat(in)=
begin
out.num_cuenta::decimal_strip(in.num_cuenta);
out.nivel::in.nivel;
end;|3|1|l|@{0|}}
