{2010501005|XXGpvertex|597|0|1675|0|{|{30100001|XXparameter_set|@@@@{{30001002|XXparameter|!prototype_path|$AB_COMPONENTS/Transform/Join.mpc|3|2|Pf$|@{0|}}
{30001002|XXparameter|in0_metadata||3|8|s=|@{0|}}
{30001002|XXparameter|reject0_metadata||3|8|s=|@{0|}}
{30001002|XXparameter|unused0_metadata||3|8|s=|@{0|}}
{30001002|XXparameter|key|\{csi; prod; inst; pref; cuenta; numcliente\}|3|2|$|@{0|}}
{30001002|XXparameter|transform|out :: join(in0, in1) =
begin
        out.*::in0.*;
        out.plaza :: if (is_null(in1.plaza)) "NA" else (string(3))(decimal(3,zerofill))in1.plaza;
        //out.num_cuenta_vip :: in0.num_cuenta_vip;
         out.tipo_cliente :: if (string_lrtrim(in0.null_dinerosuc)  == 'F' && in0.num_cuenta == 0) '02' else '01';
         out.tipo_cuenta :: if (is_null(in1.plaza)) 1 else 2;
         out.sucursal :: in0.num_sucoperadora;
         out.tipo_operacion :: in0.cve_obm;
        out.importe :: in0.imp_transaccion;
  out.nivel_cuenta::'04';
  out.CLABE::'WIP';
end;

// Este grupo de joins busca el campo plaza en los archivos LAMDA y LACTA. En caso que joinee, si no hay nada en contendio plaza devuelve NA, significando que 
// el campo CLABE debe contener 'NA'.

// Para el caso de los 2 joins superiores se utilizan num_cuenta y num_sucpromtoracta,
// pero para el caso de los 2 joins inferiores, se utilizan num_cuenta_vip y num_sucpromtoracta_vip, calculados en el reformat anterior tal y como dice la especificaci�n:
//	Formatear NUM_CUENTA a un numero de 11 d�gitos, rellenando con ceros a la izquierda de ser necesario
//	Formatear NUM_SUCPROMTORACTA a un numero de 4 d�gitos, rellenando con ceros a la izquierda de ser necesario
//	Sustituir  los primeros 4 d�gitos de NUM_CUENTA con formato de 11 d�gitos por NUM_SUCPROMTORACTA formateada a 4 d�gitos

// con estos campos se intenta nuevamente buscar la Plaza.

// en el inter�n del cambio de claves de join, se utiliza un sort para cambiar el orden, de forma acorde.|3|1|l|@{0|}}
{30001002|XXparameter|join_type|Explicit|3|1|l|@{0|}}
{30001002|XXparameter|record_required1|True|3|1|l|@{0|}}
{30001002|XXparameter|in1_metadata||3|8|s=|@{0|}}
{30001002|XXparameter|reject1_metadata||3|8|s=|@{0|}}
{30001002|XXparameter|unused1_metadata||3|8|s=|@{0|}}
{30001002|XXparameter|out_metadata||3|8|s=|@{0|}}
{30001002|XXparameter|Layout||3|8|s=|@{0|}}
