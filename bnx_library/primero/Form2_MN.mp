{30001002|XXparameter|transform|/*Join transform*/
out::join(in0,in1)=
begin
out.*::in0.*;
   //out.nivel_cuenta :1: if (is_null(in1.num_caja)) '04' else  
   //                         if (!is_null(in1.hay_nivel_cuenta)) in1.nivel_de_cuenta   else 
   //                              if (( string_compare(in1.tienda4, '9999') \|\| string_compare(in1.tienda4, '7777')  ) && !is_null(in1.nivel_de_cuenta))     
   //                                             if (in1.hay_nivel_cuenta=='N') '02' else in1.nivel_de_cuenta  else '02' ;
   //                                             
       out.nivel_cuenta :1: if (is_null(in1.nivel_de_cuenta)) '04' else  in1.nivel_de_cuenta;

                                 // if (( string_compare(first_defined(in1.tienda4 , ' '), '9999') \|\| string_compare(first_defined(in1.tienda4, ' ') , '7777')  ) && !is_null(in1.nivel_de_cuenta))     
                               //   if (!is_null(in1.nivel_de_cuenta))     
                                                 //if (is_null( in1.nivel_de_cuenta)) '02' else in1.nivel_de_cuenta  else '02' ;                                              
                                           //revisar que Abinitio no entiende IFS      
  out.tienda4:: ' ';//in1.tienda4;
  out.nivel_de_cuenta_CTOS::in1.nivel_de_cuenta;
  out.hay_nivel_cuenta_CTOS::is_null( in1.nivel_de_cuenta) ? 'N' : 'Y';
  
  out.num_contrato_mundial::' ';
  out.num_operacionalfan::string_lrtrim(in0.num_operacionalfan);
  out.hay_nivel_transfer_captacion::is_null( in1.nivel_de_cuenta) ? 'N' : 'Y';

end;|3|1|l|@{0|}}
