BEGIN
  COMMENT Mega batch bancario de reconciliacion - ALGOL (Unisys MCP);

  FILE CUSTOMER (KIND=DISK, FILETYPE=7);
  FILE ACCOUNT (KIND=DISK, FILETYPE=7);
  FILE TXN (KIND=DISK, FILETYPE=7);
  FILE CARD (KIND=DISK, FILETYPE=7);
  FILE SETTLEMENT (KIND=DISK, FILETYPE=7);
  FILE REJECTS (KIND=DISK, FILETYPE=7);

  RECORD CUSTOMER_REC;
    EBCDIC CUST_F01 [0:19];
    INTEGER CUST_F02;
    REAL CUST_F03;
    EBCDIC CUST_F04 [0:19];
    INTEGER CUST_F05;
    REAL CUST_F06;
    EBCDIC CUST_F07 [0:19];
    INTEGER CUST_F08;
    REAL CUST_F09;
    EBCDIC CUST_F10 [0:19];
    INTEGER CUST_F11;
    REAL CUST_F12;
    EBCDIC CUST_F13 [0:19];
    INTEGER CUST_F14;
    REAL CUST_F15;
    EBCDIC CUST_F16 [0:19];
    INTEGER CUST_F17;
    REAL CUST_F18;
    EBCDIC CUST_F19 [0:19];
    INTEGER CUST_F20;
    REAL CUST_F21;
    EBCDIC CUST_F22 [0:19];
  END;

  RECORD ACCOUNT_REC;
    EBCDIC ACCT_F01 [0:19];
    INTEGER ACCT_F02;
    REAL ACCT_F03;
    EBCDIC ACCT_F04 [0:19];
    INTEGER ACCT_F05;
    REAL ACCT_F06;
    EBCDIC ACCT_F07 [0:19];
    INTEGER ACCT_F08;
    REAL ACCT_F09;
    EBCDIC ACCT_F10 [0:19];
    INTEGER ACCT_F11;
    REAL ACCT_F12;
    EBCDIC ACCT_F13 [0:19];
    INTEGER ACCT_F14;
    REAL ACCT_F15;
    EBCDIC ACCT_F16 [0:19];
    INTEGER ACCT_F17;
    REAL ACCT_F18;
    EBCDIC ACCT_F19 [0:19];
    INTEGER ACCT_F20;
  END;

  RECORD TXN_REC;
    EBCDIC TXN_F01 [0:19];
    INTEGER TXN_F02;
    REAL TXN_F03;
    EBCDIC TXN_F04 [0:19];
    INTEGER TXN_F05;
    REAL TXN_F06;
    EBCDIC TXN_F07 [0:19];
    INTEGER TXN_F08;
    REAL TXN_F09;
    EBCDIC TXN_F10 [0:19];
    INTEGER TXN_F11;
    REAL TXN_F12;
    EBCDIC TXN_F13 [0:19];
    INTEGER TXN_F14;
    REAL TXN_F15;
    EBCDIC TXN_F16 [0:19];
    INTEGER TXN_F17;
    REAL TXN_F18;
    EBCDIC TXN_F19 [0:19];
    INTEGER TXN_F20;
    REAL TXN_F21;
    EBCDIC TXN_F22 [0:19];
    INTEGER TXN_F23;
    REAL TXN_F24;
  END;

  RECORD CARD_REC;
    EBCDIC CARD_F01 [0:19];
    INTEGER CARD_F02;
    REAL CARD_F03;
    EBCDIC CARD_F04 [0:19];
    INTEGER CARD_F05;
    REAL CARD_F06;
    EBCDIC CARD_F07 [0:19];
    INTEGER CARD_F08;
    REAL CARD_F09;
    EBCDIC CARD_F10 [0:19];
    INTEGER CARD_F11;
    REAL CARD_F12;
    EBCDIC CARD_F13 [0:19];
    INTEGER CARD_F14;
    REAL CARD_F15;
    EBCDIC CARD_F16 [0:19];
    INTEGER CARD_F17;
    REAL CARD_F18;
  END;

  REAL WS_ACCUM01;
  REAL WS_ACCUM02;
  REAL WS_ACCUM03;
  REAL WS_ACCUM04;
  REAL WS_ACCUM05;
  REAL WS_ACCUM06;
  REAL WS_ACCUM07;
  REAL WS_ACCUM08;

  PROCEDURE READ_CUSTOMERS;
  BEGIN
    READ (CUSTOMER, CUSTOMER_REC);
  END;

  PROCEDURE READ_ACCOUNTS;
  BEGIN
    READ (ACCOUNT, ACCOUNT_REC);
  END;

  PROCEDURE READ_TXN;
  BEGIN
    READ (TXN, TXN_REC);
  END;

  PROCEDURE READ_CARDS;
  BEGIN
    READ (CARD, CARD_REC);
  END;

  PROCEDURE FILTER_ACTIVE_CUST;
  BEGIN
    IF CUST_F01 = "A" THEN
        CONTINUE;
  END;

  PROCEDURE FILTER_VALID_TXN;
  BEGIN
    IF TXN_F03 GTR 0 AND TXN_F05 = "S" THEN
        CONTINUE;
  END;

  PROCEDURE FILTER_OPEN_ACCT;
  BEGIN
    IF ACCT_F02 = "O" THEN
        CONTINUE;
  END;

  PROCEDURE FILTER_ACTIVE_CARD;
  BEGIN
    IF CARD_F02 = "A" THEN
        CONTINUE;
  END;

  PROCEDURE JOIN_CUST_ACCT;
  BEGIN
    IF ACCT_F01 = CUST_F01 THEN
        CONTINUE;
  END;

  PROCEDURE JOIN_ACCT_TXN;
  BEGIN
    IF TXN_F02 = ACCT_F01 THEN
        CONTINUE;
  END;

  PROCEDURE JOIN_CARD_TXN;
  BEGIN
    IF CARD_F01 = TXN_F02 THEN
        CONTINUE;
  END;

  PROCEDURE COMPUTE_BALANCE;
  BEGIN
    WS_ACCUM01 := ACCT_F04 + TXN_F03;
  END;

  PROCEDURE COMPUTE_FEES;
  BEGIN
    WS_ACCUM02 := TXN_F03 * CARD_F05;
  END;

  PROCEDURE COMPUTE_INTEREST;
  BEGIN
    WS_ACCUM03 := (WS_ACCUM01 * ACCT_F06) / 100;
  END;

  PROCEDURE COMPUTE_TOTALS;
  BEGIN
    WS_ACCUM04 := WS_ACCUM04 + TXN_F03;
  END;

  PROCEDURE DETECT_FRAUD;
  BEGIN
    IF TXN_F03 GTR 10000 AND CARD_F08 = "F" THEN
        CONTINUE;
  END;

  PROCEDURE WRITE_SETTLEMENT;
  BEGIN
    WRITE (SETTLEMENT, TXN_REC);
  END;

  PROCEDURE WRITE_REJECTS;
  BEGIN
    WRITE (REJECTS, TXN_REC);
  END;

  COMMENT Programa principal;
  READ_CUSTOMERS;
  READ_ACCOUNTS;
  READ_TXN;
  READ_CARDS;
  FILTER_ACTIVE_CUST;
  FILTER_VALID_TXN;
  FILTER_OPEN_ACCT;
  FILTER_ACTIVE_CARD;
  JOIN_CUST_ACCT;
  JOIN_ACCT_TXN;
  JOIN_CARD_TXN;
  COMPUTE_BALANCE;
  COMPUTE_FEES;
  COMPUTE_INTEREST;
  COMPUTE_TOTALS;
  DETECT_FRAUD;
  WRITE_SETTLEMENT;
  WRITE_REJECTS;
END.
