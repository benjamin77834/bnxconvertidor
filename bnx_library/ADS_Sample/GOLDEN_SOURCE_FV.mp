  out.N_TOT_BONIFI_FACTURADAS ::(decimal(14,2))in.N_TOT_BONIFI_FACTURADAS;
  out.N_BONIFIC_OTRAS_COMISIONES ::(decimal(14,2))in.N_BONIFIC_OTRAS_COMISIONES;
  out.N_OTRAS_BONIF_FACT ::(decimal(14,2))in.N_OTRAS_BONIF_FACT;
  out.N_BONIF_IVA_FACT ::(decimal(14,2))in.N_BONIF_IVA_FACT;
  out.N_SALDO_CAPITAL_TASA_FIJA ::(decimal(15,2))in.N_SALDO_CAPITAL_TASA_FIJA;
  out.N_SALDO_VENC_MONTO_BASE ::(decimal(15,2))in.N_SALDO_VENC_MONTO_BASE;
  out.N_SALDO_VENCIDO_INT::(decimal(15,2))in.N_SALDO_VENCIDO_INT;
  out.N_OTROS_SALDOS_VENC::(decimal(15,2))in.N_OTROS_SALDOS_VENC;
  out.N_SALDO_CAPITAL_CORTE::(decimal(15,2))in.N_SALDO_CAPITAL_CORTE;
  out.N_SALDO_INT_GRAV_CORTE::(decimal(15,2))in.N_SALDO_INT_GRAV_CORTE;
  out.N_SALDO_INT_EXENTOS::(decimal(15,2))in.N_SALDO_INT_EXENTOS;
  out.N_SALDO_IMPUESTOS_IVA_CORTE::(decimal(15,2))in.N_SALDO_IMPUESTOS_IVA_CORTE;
  out.N_MONTO_CREDITO_DISP::(decimal(15,2))in.N_MONTO_CREDITO_DISP;  
  out.N_LINEA_CREDITO_CORTE::(decimal(10))in.N_LINEA_CREDITO_CORTE;
  out.N_INT_DEV_CORT_CIERRE_MES::(decimal(15,2))in.N_INT_DEV_CORT_CIERRE_MES;
  out.N_INT_EXEN_DEV_CORTE::(decimal(15,2))in.N_INT_EXEN_DEV_CORTE;
  out.N_INT_DEV_CIERRE_MES_ANT::(decimal(15,2))in.N_INT_DEV_CIERRE_MES_ANT;
  out.N_INT_EXENT_DEV_CIERRE_MES_ANT::(decimal(15,2))in.N_INT_EXENT_DEV_CIERRE_MES_ANT;
  out.N_SALDO_CAPITAL::(decimal(15,2))in.N_SALDO_CAPITAL;
  out.N_SALDO_INT_GRAV_DEV::(decimal(15,2))in.N_SALDO_INT_GRAV_DEV;
  out.N_SALDO_IVA::(decimal(15,2))in.N_SALDO_IVA;
  out.N_COMISIONES ::(decimal(15,2))in.N_COMISIONES;
  out.N_IVA_COMISIONES ::(decimal(15,2))in.N_IVA_COMISIONES;
  out.N_INTERESES_MORATORIOS ::(decimal(15,2))in.N_INTERESES_MORATORIOS;
  out.N_IVA_INT_MORATORIOS ::(decimal(15,2))in.N_IVA_INT_MORATORIOS;
  out.N_ESTATUS_CARTERA ::(decimal(1))in.N_ESTATUS_CARTERA;  
  out.D_FEC_ULTIMO_PAGO::if(is_valid((date("YYYYMMDD")) (string(8)) in.D_FEC_ULTIMO_PAGO)) in.D_FEC_ULTIMO_PAGO else '';/*son 6 posiciones pero no se en que formato va a venir*/ 
  out.N_CONTADOR_PAGO_CONTINUO ::(decimal(1))in.N_CONTADOR_PAGO_CONTINUO;
  out.V_IND_ESTATUS_CREDITO ::in.V_IND_ESTATUS_CREDITO;  
  out.D_FECHA_BANCO_MALO::if(is_valid((date("YYYYMMDD")) (string(8)) in.D_FECHA_BANCO_MALO)) in.D_FECHA_BANCO_MALO else '';
  out.V_MARCA_BANCO_MALO :: in.V_MARCA_BANCO_MALO;
  out.N_MARCA_CASTIGO ::(decimal(4))in.N_MARCA_CASTIGO;
  out.N_IMPORTE_BANCO_MALO ::(decimal(15,2))in.N_IMPORTE_BANCO_MALO;
  out.N_CUENTA_LIGADA_S111 ::(decimal(16))in.N_CUENTA_LIGADA_S111;
