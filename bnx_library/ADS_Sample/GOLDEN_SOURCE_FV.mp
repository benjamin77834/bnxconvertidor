{2010501005|XXGpvertex|94|0|239|0|{|{30100001|XXparameter_set|@@@@{{30001002|XXparameter|transform0|/*Reformat operation*/
out::reformat(in)=
begin

let string("\\x01") h_flag1 = ' ';
let string("\\x01") h_flag2 = ' ';
let string("\\x01") t_flag1 = ' ';
let string("\\x01") t_flag2 = ' ';
let decimal("\\x01") seq_no = next_in_sequence();
let decimal("\\x01") trl_cnt = lookup("Lkp1").record_count;
////let string("\\x01") date_1 = $ECS_S111_MISDT;
//let date("YYYYMMDD") tempdate = string_concat(string_substring(in.data,3,4),string_substring(in.data,8,2),string_substring(in.data,11,2));

if(seq_no == 1)
begin   
        if(string_substring(in.data,1,2) == '01')
        begin
                h_flag1 = 'TRUE';
                if(string_substring(in.data,3,8) == '$\{ECS_S111_MISDT\}')
                begin
                        h_flag2 = 'TRUE';
                end
                else
                        force_abort("Wrong date file");
         end
         else 
                force_abort("No header");
end
else if(seq_no == 2 )
begin
        if(string_substring(in.data,1,2) == '99')
        begin
                t_flag1 = 'TRUE';
                if((decimal("\\x01")) string_substring(in.data,3,length_of(in.data)-2) == trl_cnt)
                begin
                        t_flag2 = 'TRUE';
                end
                else 
                        force_abort("Count mis match");
         end
         else
                        force_abort("No trailer");

end
out.data :: if(seq_no == 1) string_concat('HDR\|',string_substring(in.data,3,8),'\|',string_substring(in.data,26,8),'\|') else if(seq_no == 2) string_replace(in.data,'99','TRL\|');

end;|3|3|c|@{0|}}
{30001002|XXparameter|in_metadata|record
          
string("\\n") data;      

end|3|1|l|@{0|}}
{30001002|XXparameter|!prototype_path|$AB_COMPONENTS/Transform/Reformat.mpc|3|2|Pf$|@{0|}}
