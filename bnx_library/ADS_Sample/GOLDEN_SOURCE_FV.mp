{30001002|XXparameter|transform0|/*Reformat operation*/
out::reformat(in)=
begin

let fechad=lookup('fec_lkp');
  out.*::in.*;
  out.D_MIS_DATE::(date("YYYY-MM-DD"))$ECS_S111_PRDT;
  out.D_FEC_INFO :: (date('YYYY-MM-DD')) (date('YYYYMMDD'))fechad.FEC_INFO;
 

  out.N_NO_CUENTA::(decimal(16))in.N_NO_CUENTA;
  out.N_PAGO_MINIMO::(decimal(12,2))in.N_PAGO_MINIMO;
  out.N_NUMERO_DE_CLIENTE::(decimal(12))in.N_NUMERO_DE_CLIENTE;
  out.N_BIN::(decimal(6))in.N_BIN;
  out.N_TASA_ORDI_INT_ANUAL::(decimal(4,2))in.N_TASA_ORDI_INT_ANUAL; 
  out.N_TASA_ORD_INT_MEN::(decimal(5,2))in.N_TASA_ORD_INT_MEN;
  out.N_TASA_MOR_INT_ANUAL::(decimal(5,2))in.N_TASA_MOR_INT_ANUAL;
  out.N_TASA_MOR_INT_MEN::(decimal(5,2))in.N_TASA_MOR_INT_MEN;
  out.D_FEC_ORIGINACION::if(is_valid((date("YYYYMMDD")) (string(8)) in.D_FEC_ORIGINACION)) in.D_FEC_ORIGINACION else '';
  out.D_FEC_VENCIMIENTO_CREDITO::if(is_valid((date("YYYYMMDD")) (string(8)) in.D_FEC_VENCIMIENTO_CREDITO)) in.D_FEC_VENCIMIENTO_CREDITO else '';
  out.N_PLAZO_CREDITO::(decimal(2))in.N_PLAZO_CREDITO;
  out.N_MONTO_CREDITO::(decimal(10))in.N_MONTO_CREDITO;
  out.V_MONEDA_CREDITO ::in.V_MONEDA_CREDITO;
  out.V_TIPO_AMORT_CREDITO ::in.V_TIPO_AMORT_CREDITO;
  out.V_FREC_AMORT_CAPITAL ::in.V_FREC_AMORT_CAPITAL;
  out.V_FREC_AMORT_INT ::in.V_FREC_AMORT_INT;
  out.V_TIPO_TASA_INT :: in.V_TIPO_TASA_INT;
  out.N_MONTO_PREPAGOS ::(decimal(14,2))in.N_MONTO_PREPAGOS;
  out.N_LINEA ::(decimal(2))in.N_LINEA;
  out.N_DIA_CORTE ::(decimal(2))in.N_DIA_CORTE;
  out.N_PERIODOS_VENCIDOS ::(decimal(2))in.N_PERIODOS_VENCIDOS;
  out.N_SALDO_ANTERIOR ::(decimal(15,2))in.N_SALDO_ANTERIOR;
  out.N_SALDO_CAPITAL_INICIAL ::(decimal(15,2))in.N_SALDO_CAPITAL_INICIAL;
  out.N_SALDO_INT_GRAV_INICIAL ::(decimal(15,2))in.N_SALDO_INT_GRAV_INICIAL;
  out.N_SALDO_IMPUESTOS_IVA_INI ::(decimal(15,2))in.N_SALDO_IMPUESTOS_IVA_INI;
  out.N_DISPOSICIONES ::(decimal(14,2))in.N_DISPOSICIONES;
  out.N_OTRAS_COMISIONES_FACT::(decimal(12,2))in.N_OTRAS_COMISIONES_FACT;
  out.N_INT_GRAVABLE_FACT::(decimal(14,2))in.N_INT_GRAVABLE_FACT;
  out.N_IVA_FACTURADO ::(decimal(14,2))in.N_IVA_FACTURADO;
  out.N_TOT_PAGOS_EFECTUADOS::(decimal(14,2))in.N_TOT_PAGOS_EFECTUADOS;
  out.N_PAGOS_CAPIT_EFECTUADOS ::(decimal(14,2))in.N_PAGOS_CAPIT_EFECTUADOS;
  out.N_PAGOS_INT_GRAVADOS_EFECT ::(decimal(14,2))in.N_PAGOS_INT_GRAVADOS_EFECT;
  out.N_PAGOS_IVA_EFECT ::(decimal(14,2))in.N_PAGOS_IVA_EFECT;
  out.N_TOT_PAGOS_CORTE_A_CORTE::(decimal(14,2))in.N_TOT_PAGOS_CORTE_A_CORTE;
  out.N_PAGOS_CAP_CORTE_CORTE ::(decimal(14,2))in.N_PAGOS_CAP_CORTE_CORTE;
  out.N_PAGOS_INT_GRAV_CORTE_CORTE ::(decimal(14,2))in.N_PAGOS_INT_GRAV_CORTE_CORTE;
  out.N_PAGOS_IMP_IVA_CORTE_CORTE ::(decimal(14,2))in.N_PAGOS_IMP_IVA_CORTE_CORTE;
  out.N_TOT_BONIFICACIONES ::(decimal(14,2))in.N_TOT_BONIFICACIONES;
