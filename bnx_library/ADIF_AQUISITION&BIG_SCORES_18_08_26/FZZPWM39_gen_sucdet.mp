{2010501005|XXGpvertex|217|0|630|0|{|{30100001|XXparameter_set|@@@@{{30001002|XXparameter|!prototype_path|$AB_COMPONENTS/Transform/Reformat.mpc|3|2|Pf$|@{0|}}
{30001002|XXparameter|transform0|/*Reformat operation*/
out::reformat(in)=
begin
  out.fec_transaccion :: (date("YYYY-MM-DD"))in.fec_transaccion;
  out.num_caja :: in.num_caja;
  out.num_operacion :: in.num_operacion;
  out.num_operador :: in.num_operador;
  out.num_sucoperadora :: in.num_sucoperadora;
  out.cve_txnsistema :: in.cve_txnsistema;
  out.num_sistemaorigtxn :1: in.num_sistemaorigtxn;
  out.num_operacionalfan :: in.num_operacionalfan;
  out.num_txnorigen :: in.num_txnorigen;
  out.cve_naturalezatxn :: in.cve_naturalezatxn;
  out.imp_transaccion :: in.impefedlls;
  out.cve_monedasistema :: in.cve_monedasistema;
  out.imp_tipocambiotxn :: in.tcambio;
  out.clasificacion_oemn :: 0;
  out.imp_real :: in.imp_transaccion;
  out.cve_moneda_imp_real :: 5;
  out.imp_transaccion_divisa :: 0;
  out.num_sucpromtoracta :: in.num_sucpromtoracta;
  out.num_cuenta :: in.num_cuenta;
  out.num_contrato :: "0";
  out.numcte :: in.num_cliente;
  out.clabe :: ' ';
  out.tpocta :: 0;
  out.nivcta :: 0;
  out.tpocte :: 0;
  out.form9 ::  /*is_null(lookup("RFC",in.num_cte).rfc)? 'N' : 'Y';*/ 'N';
  out.seccion :: 105;
  //out.transac_rfc:: is_null(lookup("RFC",in.num_cte).rfc)? '0' : (string("\|"))string_lrtrim(lookup("RFC",in.num_cte).rfc);
  out.instancias :: 'N';
  //out.nomsucdep :: string_lrtrim((string("\|"))(decimal("\|"))in.num_sucoperadora);
  //out.nomsubarea :: string_lrtrim((string("\|"))(decimal("\|"))in.subarea);
  
    out.nomsucdep :: in.nomsucdep;
  out.nomsubarea :: in.nomsubarea;
  out.clasificacion_od :: decimal_strip(in.cveod);
  out.num_autransaccion :: 0;
  out.cve_nacionalidacte::0;
  //out.agrptpp ::2;
  out.agrptpp :: lookup_match("CAT1583_P3",   in.num_cliente) ? 3 : 2;
  out.tp_pers :: 2;
  //out.tp_pers :: lookup_match("CAT1583_P3",   in.num_cliente) ? 3 :  2; 
  out.tact :: 1;
  
  
   /*switch(first_defined(lookup("CAT1583",  string_substring(in.fec_transaccion,1,6) , in.num_cliente).cve_com, 4))
        case 1 : '10';
        case 2 : '20';
        case 3 : '30';
        default : '1';
       end; */
  out.flag_1583 :: 'N'; /*is_null(lookup("CASH123", in.num_cliente))? 'N' : 'Y' ;*/
  out.rep_diplomatica::NULL;
//  out.cvecomisionista :: is_null(lookup("CASH123", in.num_cliente))? (string(6))(decimal(6,zerofill))(in.num_cliente % 1000000) : is_valid((decimal(6,zerofill))lookup("CASH123", in.num_cliente).cve_cashfim)? (decimal(6,zerofill))lookup("CASH123", in.num_cliente).cve_cashfim : lookup("CASH123", in.num_cliente).cve_cashfim ;
  
  
  //PP95943 NO HAY LOOKUPS ACA
 // out.cvecomisionista :: is_null(lookup("CASH123", in.num_cliente))? (decimal(6,zerofill))(in.num_cliente % 1000000) : is_valid((decimal(6,zerofill))lookup("CASH123", in.num_cliente).cve_cashfim)? (decimal(6,zerofill))lookup("CASH123", in.num_cliente).cve_cashfim : lookup("CASH123", in.num_cliente).cve_cashfim ;
  out.cvecomisionista :: NULL;
  
  
  
  
    out.fec_informacion :: (date("YYYY-MM-DD"))$FZWM3FHPROC;
  out.origen_cuenta :: 'S500';
  
  
end;|3|1|l|@{0|}}
