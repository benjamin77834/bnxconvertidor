# Imagen para SIMULAR el servidor del banco en una Mac: RHEL 8 x86_64, glibc 2.28, Python 3.11, Java 17.
# NO lleva codigo del banco ni paquetes: el ZIP se monta en tiempo de ejecucion (volumen).
#
#   podman build --platform linux/amd64 -t bnx-rhel8 -f tools/linux/Containerfile.rhel8 tools/linux
#   podman build --platform linux/amd64 --build-arg PYSPARK=3.5.6 -t bnx-rhel8-spark -f tools/linux/Containerfile.rhel8 tools/linux
#
# bnx-rhel8        : servidor SIN PySpark instalado (el paquete 'con PySpark' trae el suyo en vendor/).
# bnx-rhel8-spark  : 'servidor con PySpark ya instalado' (pyspark + py4j en el python3.11 del sistema);
#                    el paquete 'sin PySpark' lo debe detectar solo.
FROM --platform=linux/amd64 registry.access.redhat.com/ubi8/ubi
ARG PYSPARK=""
RUN dnf -y install python3.11 python3.11-pip java-17-openjdk-headless procps-ng which findutils tar gzip unzip \
        libgomp bash shadow-utils diffutils \
    && dnf clean all && rm -rf /var/cache/dnf /var/cache/yum \
    && useradd -m -u 1000 -s /bin/bash bnx \
    && mkdir -p /work && chown bnx:bnx /work \
    && alternatives --set python3 /usr/bin/python3.11 2>/dev/null || true
RUN if [ -n "$PYSPARK" ]; then python3.11 -m pip install --no-cache-dir "pyspark==$PYSPARK"; fi
ENV JAVA_HOME=/usr/lib/jvm/jre-17-openjdk LANG=C.UTF-8 PYTHONUNBUFFERED=1
USER bnx
WORKDIR /work
