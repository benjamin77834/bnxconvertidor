keys:
  Orders: order_id
  Customers: customer_id
  Products: product_id
  Payments: payment_id
  Returns: return_id

schema:
  Orders:
    order_id: string
    customer_id: string
    product_id: string
    payment_id: string
    amount: double
    status: string
    order_date: date

  Customers:
    customer_id: string
    name: string
    email: string
    region: string
    segment: string
    created_at: timestamp

  Products:
    product_id: string
    name: string
    category: string
    price: double
    stock: int

  Payments:
    payment_id: string
    customer_id: string
    amount: double
    method: string
    payment_date: date
    confirmed: boolean

  Returns:
    return_id: string
    order_id: string
    customer_id: string
    reason: string
    return_date: date
