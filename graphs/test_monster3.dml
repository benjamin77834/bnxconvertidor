keys:
  RawAccounts: account_id
  RawTransactions: tx_id
  RawCards: card_id
  RawLoans: loan_id
  RawPayments: payment_id
  RawCustomers: customer_id
  RawBranches: branch_id
  RawProducts: product_id
  RawFXRates: currency
  RawRiskScores: customer_id
  RawAlerts: alert_id
  RawAuditLog: log_id

schema:
  RawAccounts:
    account_id: string
    customer_id: string
    account_type: string
    balance: double
    currency: string
    branch_id: string
    opened_at: timestamp

  RawTransactions:
    tx_id: string
    account_id: string
    customer_id: string
    amount: double
    currency: string
    tx_type: string
    branch_id: string
    product_id: string
    tx_date: date
    status: string

  RawCards:
    card_id: string
    customer_id: string
    card_type: string
    benefits: string
    credit_limit: double
    expiry_date: date
    active: boolean

  RawLoans:
    loan_id: string
    customer_id: string
    principal: double
    interest_rate: double
    term_months: int
    status: string
    disbursed_at: date

  RawPayments:
    payment_id: string
    customer_id: string
    amount: double
    method: string
    branch_id: string
    payment_date: date
    confirmed: boolean

  RawCustomers:
    customer_id: string
    name: string
    email: string
    phone: string
    segment: string
    risk_level: string
    branch_id: string
    created_at: timestamp

  RawBranches:
    branch_id: string
    branch_name: string
    region: string
    city: string
    manager_id: string

  RawProducts:
    product_id: string
    product_name: string
    category: string
    features: string
    fee: double

  RawFXRates:
    currency: string
    rate_to_usd: double
    rate_date: date

  RawRiskScores:
    customer_id: string
    risk_score: double
    risk_category: string
    scored_at: timestamp

  RawAlerts:
    alert_id: string
    customer_id: string
    tx_id: string
    alert_type: string
    tags: string
    severity: string
    created_at: timestamp

  RawAuditLog:
    log_id: string
    customer_id: string
    action: string
    entity_type: string
    entity_id: string
    timestamp: timestamp
