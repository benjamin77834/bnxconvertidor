BEGIN
  COMMENT Ejemplo de batch bancario en ALGOL (estilo Unisys MCP);

  FILE CUSTOMER (KIND=DISK, FILETYPE=7);
  FILE TRANSACTION (KIND=DISK, FILETYPE=7);
  FILE ACCOUNT (KIND=DISK, FILETYPE=7);
  FILE REPORT (KIND=PRINTER);
  FILE ERRORFILE (KIND=DISK, FILETYPE=7);

  RECORD CUSTOMER_REC;
    EBCDIC CUST_ID [0:9];
    EBCDIC CUST_NAME [0:29];
    EBCDIC CUST_REGION [0:9];
    REAL   CUST_BALANCE;
    EBCDIC CUST_STATUS [0:0];
  END;

  RECORD TRANSACTION_REC;
    EBCDIC TX_ID [0:11];
    EBCDIC TX_CUST_ID [0:9];
    REAL   TX_AMOUNT;
    EBCDIC TX_TYPE [0:2];
    EBCDIC TX_STATUS [0:0];
  END;

  RECORD ACCOUNT_REC;
    EBCDIC ACCT_ID [0:9];
    EBCDIC ACCT_CUST_ID [0:9];
    REAL   ACCT_BALANCE;
  END;

  REAL TOTAL_AMOUNT;
  INTEGER TX_COUNT;

  PROCEDURE READ_CUSTOMERS;
  BEGIN
    READ (CUSTOMER, CUSTOMER_REC);
  END;

  PROCEDURE FILTER_ACTIVE_CUSTOMERS;
  BEGIN
    IF CUST_STATUS = "A" THEN
      CONTINUE;
  END;

  PROCEDURE FILTER_VALID_TRANSACTIONS;
  BEGIN
    IF TX_AMOUNT GTR 0 AND TX_STATUS = "S" THEN
      CONTINUE;
  END;

  PROCEDURE JOIN_CUSTOMER_TX;
  BEGIN
    IF TX_CUST_ID = CUST_ID THEN
      CONTINUE;
  END;

  PROCEDURE COMPUTE_TOTALS;
  BEGIN
    TOTAL_AMOUNT := TOTAL_AMOUNT + TX_AMOUNT;
    TX_COUNT := TX_COUNT + 1;
  END;

  PROCEDURE WRITE_REPORT;
  BEGIN
    WRITE (REPORT, CUSTOMER_REC);
  END;

  COMMENT Programa principal;
  READ_CUSTOMERS;
  FILTER_ACTIVE_CUSTOMERS;
  FILTER_VALID_TRANSACTIONS;
  JOIN_CUSTOMER_TX;
  COMPUTE_TOTALS;
  WRITE_REPORT;

END.
