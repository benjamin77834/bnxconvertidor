BEGIN
  COMMENT Liquidacion de tarjetas - batch ALGOL (estilo Unisys MCP);

  FILE CARDTX (KIND=DISK, FILETYPE=7);
  FILE MERCHANT (KIND=DISK, FILETYPE=7);
  FILE SETTLEMENT (KIND=DISK, FILETYPE=7);
  FILE REJECTS (KIND=DISK, FILETYPE=7);

  RECORD CARDTX_REC;
    EBCDIC CARD_NUMBER [0:15];
    EBCDIC MERCHANT_ID [0:9];
    REAL   TX_AMOUNT;
    EBCDIC TX_CURRENCY [0:2];
    EBCDIC TX_STATUS [0:0];
    EBCDIC AUTH_CODE [0:5];
  END;

  RECORD MERCHANT_REC;
    EBCDIC MERCHANT_ID [0:9];
    EBCDIC MERCHANT_NAME [0:39];
    EBCDIC MERCHANT_CATEGORY [0:3];
    REAL   COMMISSION_RATE;
  END;

  REAL TOTAL_SETTLED;
  REAL TOTAL_COMMISSION;
  INTEGER REJECT_COUNT;

  PROCEDURE READ_CARD_TX;
  BEGIN
    READ (CARDTX, CARDTX_REC);
  END;

  PROCEDURE FILTER_APPROVED;
  BEGIN
    IF TX_STATUS = "A" AND TX_AMOUNT GTR 0 THEN
      CONTINUE;
  END;

  PROCEDURE FILTER_REJECTED;
  BEGIN
    IF TX_STATUS NEQ "A" THEN
      REJECT_COUNT := REJECT_COUNT + 1;
  END;

  PROCEDURE JOIN_MERCHANT;
  BEGIN
    IF MERCHANT_ID = MERCHANT_ID THEN
      CONTINUE;
  END;

  PROCEDURE COMPUTE_SETTLEMENT;
  BEGIN
    TOTAL_SETTLED := TOTAL_SETTLED + TX_AMOUNT;
  END;

  PROCEDURE WRITE_SETTLEMENT;
  BEGIN
    WRITE (SETTLEMENT, CARDTX_REC);
  END;

  COMMENT Programa principal;
  READ_CARD_TX;
  FILTER_APPROVED;
  FILTER_REJECTED;
  JOIN_MERCHANT;
  COMPUTE_SETTLEMENT;
  WRITE_SETTLEMENT;

END.
